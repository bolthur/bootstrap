diff --git gcc/config/bolthur.h gcc/config/bolthur.h
new file mode 100644
index 00000000000..e72afca4989
--- /dev/null
+++ gcc/config/bolthur.h
@@ -0,0 +1,75 @@
+
+/* Useful if you wish to make target-specific GCC changes. */
+#undef TARGET_BOLTHUR
+#define TARGET_BOLTHUR 1
+
+/* Machine dependent libraries. */
+#undef LIB_SPEC
+#define LIB_SPEC "-lc -lg -lm -lgloss-bolthur"
+
+/* Files that are linked before user code. */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{!shared: \
+    %{!static:bolthur-crt0.o%s;:bolthur-crt0-static.o%s} \
+  } \
+  crti.o%s \
+  %{static:crtbeginT.o%s;shared|pie:crtbeginS.o%s;:crtbegin.o%s}"
+
+/* Files that are linked after user code. */
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "%{shared|pie:crtendS.o%s;:crtend.o%s} \
+  crtn.o%s"
+
+/* Dynamic linker */
+#undef DYNAMIC_LINKER
+#define DYNAMIC_LINKER "/lib/ld-bolthur.so"
+
+#undef LIBGCC_SPEC
+#define LIBGCC_SPEC " \
+ %{static|static-libgcc:-lgcc -lgcc_eh} \
+ %{!static:%{!static-libgcc:-lgcc_s -lgcc}}"
+
+/* Linker enforce 4K pages and handle shared libraries */
+#undef LINK_SPEC
+#define LINK_SPEC \
+  "-z max-page-size=4096 \
+  %{shared:-shared} \
+  %{!shared: \
+    %{static:-static} \
+    %{!static: \
+      %{rdynamic:-export-dynamic} \
+      -dynamic-linker " DYNAMIC_LINKER " \
+    } \
+  }"
+
+/* Use --as-needed -lgcc_s for eh support */
+#ifdef HAVE_LD_AS_NEEDED
+#define USE_LD_AS_NEEDED 1
+#endif
+
+// /* Start file prefix  */
+// #undef STANDARD_STARTFILE_PREFIX
+// #define STANDARD_STARTFILE_PREFIX "/usr/lib/"
+// /* Default include directory */
+// #undef GCC_INCLUDE_DIR
+// #define GCC_INCLUDE_DIR "/usr/include"
+//
+// /* Include directory */
+// #undef GPLUSPLUS_INCLUDE_DIR
+// #define GPLUSPLUS_INCLUDE_DIR "/usr/include/g++"
+//
+// /* Compiler backend folder */
+// #undef STANDARD_EXEC_PREFIX
+// #define STANDARD_EXEC_PREFIX "/usr/libexec/"
+
+/* Additional predefined macros. */
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS() \
+  do { \
+    builtin_define ( "__bolthur__" ); \
+    builtin_define ( "__unix__" ); \
+    builtin_assert ( "system=bolthur"); \
+    builtin_assert ( "system=unix"); \
+  } while(0);
