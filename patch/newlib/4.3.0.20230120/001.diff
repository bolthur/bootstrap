diff --git newlib/libc/sys/bolthur/mntent/getmntent.c newlib/libc/sys/bolthur/mntent/getmntent.c
new file mode 100644
index 000000000..6a45a2184
--- /dev/null
+++ newlib/libc/sys/bolthur/mntent/getmntent.c
@@ -0,0 +1,135 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdio.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <mntent.h>
+
+#define BUFFER_SIZE 4096
+static char* buffer = NULL;
+
+/**
+ * @brief Helper to decode the name
+ *
+ * @param buf
+ * @return char*
+ */
+static char* decode_name ( char* buf ) {
+  char* rp = buf;
+  char* wp = buf;
+
+  do {
+    if (rp[0] == '\\' && rp[1] == '0' && rp[2] == '4' && rp[3] == '0') {
+      /* \040 is a SPACE.  */
+      *wp++ = ' ';
+      rp += 3;
+    } else if (rp[0] == '\\' && rp[1] == '0' && rp[2] == '1' && rp[3] == '2') {
+      /* \012 is a TAB.  */
+      *wp++ = '\t';
+      rp += 3;
+    } else if (rp[0] == '\\' && rp[1] == '\\') {
+      /* We have to escape \\ to be able to represent all characters.  */
+      *wp++ = '\\';
+      rp += 1;
+    } else {
+      *wp++ = *rp;
+    }
+  } while (*rp++ != '\0');
+  return buf;
+}
+
+/**
+ * @brief Get the mntent object
+ *
+ * @param fp
+ * @param result
+ * @param buffer
+ * @param bufsize
+ * @return struct mntent*
+ */
+struct mntent* getmntent_r(
+  FILE* fp,
+  struct mntent* result,
+  char *buffer,
+  size_t bufsize
+) {
+  char* line = NULL;
+  size_t size = 0;
+  // try to read next valid line line
+  do {
+    // handle read line failed or end of file reached
+    if ( -1 == __getline(&line, &size, fp ) || feof(fp) ) {
+      if ( line ) {
+        free( line );
+      }
+      return NULL;
+    }
+  } while ('\0' == line[0] || '#' == line[0]);
+
+  char* cp = strsep( &line, " \t" );
+  result->mnt_fsname = cp != NULL ? decode_name( cp ) : ( char* )"";
+  if ( line ) {
+    line += strspn( line, " \t" );
+  }
+  cp = strsep( &line, " \t" );
+  result->mnt_dir = cp != NULL ? decode_name( cp ) : ( char* )"";
+  if ( line ) {
+    line += strspn( line, " \t" );
+  }
+  cp = strsep( &line, " \t" );
+  result->mnt_type = cp != NULL ? decode_name( cp ) : ( char* )"";
+  if ( line ) {
+    line += strspn( line, " \t" );
+  }
+  cp = strsep( &line, " \t" );
+  result->mnt_opts = cp != NULL ? decode_name( cp ) : ( char* )"";
+  if ( line ) {
+    line += strspn( line, " \t" );
+  }
+  switch (
+    line
+      ? sscanf ( line, " %d %d ", &result->mnt_freq, &result->mnt_passno )
+      : 0
+  ) {
+    case 0:
+      result->mnt_freq = 0;
+    case 1:
+      result->mnt_passno = 0;
+    case 2:
+      break;
+  }
+  // return result
+  return result;
+}
+
+/**
+ * @brief Get mount entry
+ *
+ * @param fp
+ * @return struct mntent*
+ */
+__weak_symbol struct mntent* getmntent( FILE* fp ) {
+  // static for result
+  static struct mntent entry;
+  // allocate buffer
+  size_t buffer_size = sizeof( char ) * BUFFER_SIZE;
+  if ( ! buffer ) {
+    buffer = malloc( buffer_size );
+    if ( ! buffer ) {
+      return NULL;
+    }
+  }
+  // clear out everything
+  memset( &entry, 0, sizeof( struct mntent ) );
+  memset( buffer, 0, buffer_size );
+  // read entry
+  return getmntent_r( fp, &entry, buffer, buffer_size );
+}
diff --git newlib/libc/sys/bolthur/mntent/hasmntopt.c newlib/libc/sys/bolthur/mntent/hasmntopt.c
new file mode 100644
index 000000000..105a0e966
--- /dev/null
+++ newlib/libc/sys/bolthur/mntent/hasmntopt.c
@@ -0,0 +1,43 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdio.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <mntent.h>
+
+char* hasmntopt( const struct mntent* mnt, const char* opt )
+{
+  size_t optlen = strlen( opt );
+  char* rest = mnt->mnt_opts;
+  char* p;
+
+  while ( ( p = strstr( rest, opt ) ) ) {
+    // check for match
+    if (
+      p == rest || (
+        p[ -1 ] == ',' && (
+          p[ optlen ] == '\0'
+          || p[ optlen ] == '='
+          || p[ optlen ] == ','
+        )
+      )
+    ) {
+      return p;
+    }
+    // adjust rest
+    rest = strchr( rest, ',' );
+    if ( ! rest ) {
+      break;
+    }
+    rest++;
+  }
+  return NULL;
+}
