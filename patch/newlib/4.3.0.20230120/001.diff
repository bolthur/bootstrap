diff --git newlib/libc/sys/bolthur/syscall/syscall-open.c newlib/libc/sys/bolthur/syscall/syscall-open.c
new file mode 100644
index 000000000..48d6d1bf7
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-open.c
@@ -0,0 +1,104 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <assert.h>
+#include <string.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+#include <stdlib.h>
+
+/**
+ * @brief Static open request used within open
+ */
+static vfs_open_request_t request;
+
+/**
+ * @brief Static open response used within open
+ */
+static vfs_open_response_t response;
+
+/**
+ * @brief Open implementation
+ *
+ * @note static request / response necessary due to dlmalloc and random usage
+ *
+ * @param name
+ * @param flags
+ * @param mode
+ * @return int
+ *
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol int _open( const char* name, int flags, ... ) {
+  int mode = 0;
+  // specify whether third parameter will be set or not
+  if ( flags & O_CREAT ) {
+    va_list parameter;
+    // get optional mode argument
+    va_start( parameter, flags );
+    mode = va_arg( parameter, int );
+    va_end( parameter );
+  }
+  // handle path to long
+  if ( PATH_MAX < strlen( name ) ) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  // allocate message structures
+  memset( &request, 0, sizeof( request ) );
+  memset( &response, 0, sizeof( response ) );
+  // prepare message structure
+  strcpy( request.path, name );
+  request.flags = flags;
+  request.mode = mode;
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_OPEN,
+    VFS_DAEMON_ID,
+    &request,
+    sizeof( request ),
+    NULL,
+    RPC_VFS_OPEN,
+    &request,
+    sizeof( request ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data(
+    &response,
+    sizeof( response ),
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    return -1;
+  }
+  // special error handling
+  if ( response.handle < 0 ) {
+    errno = -response.handle;
+    return -1;
+  }
+  int handle = response.handle;
+  // return handle
+  return handle;
+}
diff --git newlib/libc/sys/bolthur/syscall/syscall-read.c newlib/libc/sys/bolthur/syscall/syscall-read.c
new file mode 100644
index 000000000..e74ff42dd
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-read.c
@@ -0,0 +1,130 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian FreitagFreitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <assert.h>
+#include <string.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @brief Static read request used within read
+ */
+static vfs_read_request_t request;
+
+/**
+ * @brief Static read response used within read
+ */
+static vfs_read_response_t response;
+
+/**
+ * @brief Read implementation
+ *
+ * @note static request / response necessary due to dlmalloc and random usage
+ *
+ * @param file
+ * @param ptr
+ * @param len
+ * @return
+ *
+ * @todo add support for stdin
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol ssize_t _read( int file, void* ptr, size_t len ) {
+  size_t read_amount = 0;
+  char* buf = ( char* )ptr;
+  /// FIXME: Add stdin handling
+  if ( file == STDIN_FILENO ) {
+    errno = ENOSYS;
+    return -1;
+  }
+  // create shared memory entry in case amount is to large
+  void* shm_addr = NULL;
+  // create shared memory entry
+  size_t shm_id = _syscall_memory_shared_create( len );
+  if ( errno ) {
+    return -1;
+  }
+  // attach shared area
+  while ( true ) {
+    // attach area
+    shm_addr = _syscall_memory_shared_attach( shm_id, ( uintptr_t )NULL );
+    // try again on error
+    if ( errno ) {
+      continue;
+    }
+    // all done
+    break;
+  }
+  // allocate message structures
+  memset( &request, 0, sizeof( request ) );
+  memset( &response, 0, sizeof( response ) );
+  // prepare message structure
+  request.len = len;
+  request.handle = file;
+  request.shm_id = shm_id;
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_READ,
+    VFS_DAEMON_ID,
+    &request,
+    sizeof( request ),
+    NULL,
+    RPC_VFS_READ,
+    &request,
+    sizeof( request ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    // detach shared memory
+    _syscall_memory_shared_detach( shm_id );
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data(
+    &response,
+    sizeof( response ),
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    int e = errno;
+    // detach shared memory
+    _syscall_memory_shared_detach( shm_id );
+    errno = e;
+    return -1;
+  }
+  // special error handling
+  if ( 0 > response.len ) {
+    // detach shared memory
+    _syscall_memory_shared_detach( shm_id );
+    errno = -response.len;
+    return -1;
+  // copy content
+  } else if ( 0 < response.len ) {
+    memcpy( buf, shm_addr, ( size_t )response.len );
+    // increase by len
+    read_amount += ( size_t )response.len;
+  }
+  // detach shared area
+  _syscall_memory_shared_detach( shm_id );
+  // return read amount
+  return ( ssize_t )read_amount;
+}
