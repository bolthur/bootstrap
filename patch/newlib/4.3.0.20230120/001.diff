diff --git newlib/libc/sys/bolthur/rpc/rpc-handler.c newlib/libc/sys/bolthur/rpc/rpc-handler.c
new file mode 100644
index 000000000..5cbb384cf
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-handler.c
@@ -0,0 +1,94 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+#include <sys/bolthur.h>
+#include <signal.h>
+
+/**
+ * @fn void _bolthur_default_rpc_handler(size_t, pid_t, size_t, size_t)
+ * @brief default rpc handler entry point
+ *
+ * @param num
+ * @param origin
+ * @param data_info
+ * @param response_info
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void _bolthur_default_rpc_handler(
+  size_t num,
+  pid_t origin,
+  size_t data_info,
+  size_t response_id
+) {
+  // handle bind interrupt
+  if ( num <= RPC_INTERRUPT_END ) {
+    // call interrupt handler
+    if ( _bolthur_handler_interrupt[ num ] ) {
+      _bolthur_handler_interrupt[ num ]( num, origin, data_info, response_id );
+      //EARLY_STARTUP_PRINT( "Calling interrupt handler %d\r\n", num )
+    }
+    //EARLY_STARTUP_PRINT( "Skipping rest\r\n" )
+    return;
+  }
+
+  // signals
+  if ( num >= RPC_SIGNAL_START && num <= RPC_SIGNAL_END ) {
+    //EARLY_STARTUP_PRINT( "Raising signal %d\r\n", ( num - RPC_SIGNAL_START ) )
+    raise( ( int )( num - RPC_SIGNAL_START ) );
+    //EARLY_STARTUP_PRINT( "Skipping rest\r\n" )
+    return;
+  }
+
+  // raised flag
+  bool raised = false;
+  // check for bound callback
+  if ( response_id ) {
+    // try to get async callback by response id
+    rpc_handler_t callback = bolthur_rpc_async_callback( response_id );
+    // handle set callback
+    if ( callback ) {
+      //EARLY_STARTUP_PRINT( "Calling set rpc callback for  %d\r\n", response_id )
+      callback( num, origin, data_info, response_id );
+      // set flag
+      raised = true;
+    }
+  }
+
+  // try to find matching handler
+  if ( ! raised ) {
+    //EARLY_STARTUP_PRINT( "Incoming rpc: %d\r\n", num )
+    // custom handler
+    for ( size_t idx = 0; idx < _bolthur_handler_custom_size; idx++ ) {
+      // call handler if num is equal
+      if ( num == _bolthur_handler_custom[ idx ].num ) {
+        //EARLY_STARTUP_PRINT( "Calling custom rpc handler %d\r\n", num )
+        _bolthur_handler_custom[ idx ].handler(
+          num,
+          origin,
+          data_info,
+          response_id
+        );
+        // set flag
+        raised = true;
+      }
+    }
+  }
+
+  // handle no raised handler
+  if ( !raised ) {
+    // FIXME: ADD SOMEHOW GENERIC VFS RETURN IF NOT RAISED
+    EARLY_STARTUP_PRINT( "No handler for incoming rpc: %d\r\n", num )
+  }
+
+  // call to rpc end
+  _syscall_rpc_end();
+}
diff --git newlib/libc/sys/bolthur/rpc/rpc-init.c newlib/libc/sys/bolthur/rpc/rpc-init.c
new file mode 100644
index 000000000..6a46c5495
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-init.c
@@ -0,0 +1,141 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+
+// interrupt handler with fixed size
+rpc_handler_t _bolthur_handler_interrupt[ UINT8_MAX + 1 ];
+// custom handler with dynamic size
+struct handler_container* _bolthur_handler_custom;
+size_t _bolthur_handler_custom_size;
+// async data list with dynamic size
+bolthur_async_data_t* _bolthur_async_data;
+size_t _bolthur_async_data_size;
+
+/**
+ * @fn bool _bolthur_rpc_default_init(void)
+ * @brief Helper to setup default rpc handler
+ *
+ * @return true
+ * @return false
+ */
+static bool _bolthur_rpc_default_init( void ) {
+  bolthur_rpc_bind( RPC_TIMER, _bolthur_default_rpc_handle_timer, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_ADD, _bolthur_default_rpc_handle_add, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_BOOT_INIT, _bolthur_default_rpc_handle_boot_init, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_CLOSE, _bolthur_default_rpc_handle_close, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_EXIT, _bolthur_default_rpc_handle_exit, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_FORK, _bolthur_default_rpc_handle_fork, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_IOCTL, _bolthur_default_rpc_handle_ioctl, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_MOUNT, _bolthur_default_rpc_handle_mount, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_OPEN, _bolthur_default_rpc_handle_open, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_READ, _bolthur_default_rpc_handle_read, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_REMOVE, _bolthur_default_rpc_handle_remove, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_SEEK, _bolthur_default_rpc_handle_seek, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_STAT, _bolthur_default_rpc_handle_stat, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_UMOUNT, _bolthur_default_rpc_handle_umount, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_WRITE, _bolthur_default_rpc_handle_write, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_WATCH_NOTIFY, _bolthur_default_rpc_handle_watch_notify, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_WATCH_REGISTER, _bolthur_default_rpc_handle_watch_register, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_WATCH_RELEASE, _bolthur_default_rpc_handle_watch_release, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_GETDENTS, _bolthur_default_rpc_handle_getdents, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_REGISTER_HANDLER, _bolthur_default_rpc_handle_register_handler, true );
+  if ( errno ) {
+    return false;
+  }
+  bolthur_rpc_bind( RPC_VFS_RELEASE_HANDLER, _bolthur_default_rpc_handle_release_handler, true );
+  if ( errno ) {
+    return false;
+  }
+  return true;
+}
+
+/**
+ * @fn void _bolthur_rpc_setup(void)
+ * @brief rpc setup constructor
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void _bolthur_rpc_setup( void ) {
+  // set rpc handler
+  _syscall_rpc_set_handler( ( uintptr_t )_bolthur_default_rpc_handler );
+  if ( errno ) {
+    exit( 1 );
+  }
+  // clear fixed width interrupt and signal handler arrays
+  memset( _bolthur_handler_interrupt, 0, sizeof( _bolthur_handler_interrupt ) );
+  // initialize custom handler stuff
+  _bolthur_handler_custom = NULL;
+  _bolthur_handler_custom_size = 0;
+  // initialize async stuff
+  _bolthur_async_data = NULL;
+  _bolthur_async_data_size = 0;
+  // bind default handler
+  if ( ! _bolthur_rpc_default_init() ) {
+    exit( 1 );
+  }
+}
diff --git newlib/libc/sys/bolthur/rpc/rpc-raise.c newlib/libc/sys/bolthur/rpc/rpc-raise.c
new file mode 100644
index 000000000..a4ba88022
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-raise.c
@@ -0,0 +1,143 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+
+/**
+ * @fn size_t bolthur_rpc_raise_generic(size_t, pid_t, void*, size_t, rpc_handler_t, size_t, void*, size_t, pid_t, size_t, void*, bool)
+ * @brief Perform rpc
+ *
+ * @param type rpc type
+ * @param target target process
+ * @param data data to send
+ * @param length data size
+ * @param callback callback to use (async request if not NULL)
+ * @param save_type type to save for async handling
+ * @param save_data data to save for async handling
+ * @param save_length save data size to save for async handling
+ * @param save_origin origin process
+ * @param save_data_id rpc data id where raise is called within
+ * @param context additional data to be stored
+ * @param no_return raise rpc without return
+ * @return size_t response id if synchronous request, else 0
+ *
+ * @see _syscall_rpc_raise
+ * @see bolthur_rpc_push_async
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol size_t bolthur_rpc_raise_generic(
+  size_t type,
+  pid_t target,
+  void* data,
+  size_t length,
+  rpc_handler_t callback,
+  size_t save_type,
+  void* save_data,
+  size_t save_length,
+  pid_t save_origin,
+  size_t save_data_id,
+  void* context,
+  bool no_return
+) {
+  // no return with callback is not allowed
+  if ( callback && no_return ) {
+    errno = EINVAL;
+    return 0;
+  }
+  // raise rpc
+  size_t response_data_id = _syscall_rpc_raise(
+    type,
+    target,
+    data,
+    length,
+    save_data_id,
+    ! callback,
+    no_return
+  );
+  // handle error by returning
+  if ( errno ) {
+    return -errno;
+  }
+  if ( no_return ) {
+    return 0;
+  }
+  // push to async rpc list
+  if ( callback ) {
+    // push async data until it worked
+    bool push = false;
+    do {
+      push = bolthur_rpc_push_async(
+        save_type,
+        response_data_id,
+        save_data,
+        save_length,
+        save_origin,
+        save_data_id,
+        callback,
+        context
+      );
+    } while ( ! push );
+  }
+  // return response data id
+  return response_data_id;
+}
+
+/**
+ * @fn size_t bolthur_rpc_raise(size_t, pid_t, void*, size_t, rpc_handler_t, size_t, void*, size_t, pid_t, size_t, void*)
+ * @brief Perform rpc
+ *
+ * @param type rpc type
+ * @param target target process
+ * @param data data to send
+ * @param length data size
+ * @param callback callback to use (async request if not NULL)
+ * @param save_type type to save for async handling
+ * @param save_data data to save for async handling
+ * @param save_length save data size to save for async handling
+ * @param save_origin origin process
+ * @param save_data_id rpc data id where raise is called within
+ * @param context additional data to be stored
+ * @return size_t response id if synchronous request, else 0
+ *
+ * @see _syscall_rpc_raise
+ * @see bolthur_rpc_push_async
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol size_t bolthur_rpc_raise(
+  size_t type,
+  pid_t target,
+  void* data,
+  size_t length,
+  rpc_handler_t callback,
+  size_t save_type,
+  void* save_data,
+  size_t save_length,
+  pid_t save_origin,
+  size_t save_data_id,
+  void* context
+) {
+  return bolthur_rpc_raise_generic(
+    type,
+    target,
+    data,
+    length,
+    callback,
+    save_type,
+    save_data,
+    save_length,
+    save_origin,
+    save_data_id,
+    context,
+    false
+  );
+}
diff --git newlib/libc/sys/bolthur/rpc/rpc-return.c newlib/libc/sys/bolthur/rpc/rpc-return.c
new file mode 100644
index 000000000..e41b26387
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-return.c
@@ -0,0 +1,44 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+
+/**
+ * @fn void bolthur_rpc_return(size_t,void*,size_t,bolthur_async_data_t*)
+ * @brief Return from rpc
+ *
+ * @param type return type
+ * @param data return data
+ * @param length return length
+ * @param async async data container or NULL
+ *
+ * @see _syscall_rpc_ret
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void bolthur_rpc_return(
+  size_t type,
+  void* data,
+  size_t length,
+  bolthur_async_data_t* async
+) {
+  // raise return system call
+  while ( true ) {
+    _syscall_rpc_ret( type, data, length, async ? async->original_rpc_id : 0 );
+    // handle error
+    if ( errno ) {
+      continue;
+    }
+    // break out
+    break;
+  }
+  // destroy async data
+  bolthur_rpc_destroy_async( async );
+}
