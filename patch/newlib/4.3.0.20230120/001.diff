diff --git newlib/libc/sys/bolthur/syscall/syscall-close.c newlib/libc/sys/bolthur/syscall/syscall-close.c
new file mode 100644
index 000000000..afc1951a7
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-close.c
@@ -0,0 +1,87 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <assert.h>
+#include <string.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+#include <stdlib.h>
+
+/**
+ * @brief Static close request used within close
+ */
+static vfs_close_request_t request;
+
+/**
+ * @brief Static close response used within close
+ */
+static vfs_close_response_t response;
+
+/**
+ * @brief Close implementation
+ *
+ * @note static request / response necessary due to dlmalloc and random usage
+ *
+ * @param file
+ * @return int
+ *
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol int _close( int file ) {
+  // allocate message structures
+  memset( &request, 0, sizeof( request ) );
+  memset( &response, 0, sizeof( response ) );
+  // prepare message structure
+  request.handle = file;
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_CLOSE,
+    VFS_DAEMON_ID,
+    &request,
+    sizeof( request ),
+    NULL,
+    RPC_VFS_CLOSE,
+    &request,
+    sizeof( request ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data(
+    &response,
+    sizeof( response ),
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    return -1;
+  }
+  // special error handling
+  if ( response.status < 0 ) {
+    errno = -response.status;
+    return -1;
+  }
+  // cache status for local free
+  int status = response.status;
+  // return status
+  return status;
+}
diff --git newlib/libc/sys/bolthur/syscall/syscall-execve.c newlib/libc/sys/bolthur/syscall/syscall-execve.c
new file mode 100644
index 000000000..efd955f9e
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-execve.c
@@ -0,0 +1,173 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+#include <machine/elf.h>
+
+/**
+ * @fn int _execve(const char*, char* const[], char* const[])
+ * @brief Execute file
+ *
+ * @param name path to executable
+ * @param argv arguments
+ * @param env environment
+ * @return
+ */
+__weak_symbol int _execve( const char* name, char* const argv[], char* const env[] ) {
+  int fd;
+  char* interp;
+  char* exe;
+  // validate executable
+  if ( ! elf_validate_header( name ) ) {
+    errno = ENOEXEC;
+    return -1;
+  }
+  // try to get interpreter
+  interp = elf_read_optional_interpreter( name );
+  // determine file to load
+  exe = interp ? interp : ( char* )name;
+  // validate again ( as it may be different )
+  if ( 0 != strcmp( exe, name ) && ! elf_validate_header( exe ) ) {
+    errno = ENOEXEC;
+    return -1;
+  }
+  // open executable
+  fd = open( exe, O_RDONLY );
+  // check file descriptor return
+  if ( -1 == fd ) {
+    free( interp );
+    errno = EIO;
+    return -1;
+  }
+  // get to end of file
+  long position = lseek( fd, 0, SEEK_END );
+  if ( -1 == position ) {
+    free( interp );
+    errno = EIO;
+    close( fd );
+    return -1;
+  }
+  size_t size = ( size_t )position;
+  // reset back to beginning
+  if ( -1 == lseek( fd, 0, SEEK_SET ) ) {
+    free( interp );
+    errno = EIO;
+    close( fd );
+    return -1;
+  }
+  // allocate image space temporary
+  uint8_t* image = malloc( sizeof( uint8_t ) * size );
+  if ( ! image ) {
+    free( interp );
+    errno = ENOMEM;
+    close( fd );
+    return -1;
+  }
+  // read whole file
+  ssize_t n = read( fd, image, sizeof( uint8_t ) * size );
+  // handle error
+  if ( -1 == n ) {
+    free( interp );
+    free( image );
+    close( fd );
+    errno = EIO;
+    return -1;
+  }
+  // handle possible error
+  if ( ( size_t )n != size ) {
+    free( interp );
+    free( image );
+    close( fd );
+    return -1;
+  }
+  // close opened file handle again
+  close( fd );
+  // prepare arguments
+  size_t argv_count = 0;
+  char** tmp_argv = NULL;
+  while ( argv && argv[ argv_count ] ) {
+    argv_count++;
+  }
+  // prepare argv
+  if ( 0 < argv_count ) {
+    size_t len;
+    // allocate stuff ( +1 for null termination, +1 for executable and +1 for linker.so )
+    size_t offset = interp ? 3 : 1;
+    tmp_argv = ( char** )malloc( ( argv_count + offset ) * sizeof( char* ) );
+    if ( ! tmp_argv ) {
+      free( interp );
+      free( image );
+      errno = ENOMEM;
+      return -1;
+    }
+    uint32_t idx = 0;
+    if ( interp ) {
+      // copy linker path
+      len = strlen( interp ) + 1;
+      tmp_argv[ idx ] = malloc( len );
+      if ( ! tmp_argv[ idx ] ) {
+        errno = ENOMEM;
+        free( interp );
+        free( image );
+        return -1;
+      }
+      memcpy( tmp_argv[ idx ], interp, len );
+      idx++;
+      // copy executable
+      len = strlen( name ) + 1;
+      tmp_argv[ idx ] = malloc( len );
+      if ( ! tmp_argv[ idx ] ) {
+        for ( size_t free_idx = 0; free_idx < idx; free_idx++ ) {
+          free( tmp_argv[ free_idx ] );
+        }
+        free( tmp_argv );
+        free( interp );
+        free( image );
+        errno = ENOMEM;
+        return -1;
+      }
+      memcpy( tmp_argv[ idx ], name, len );
+      idx++;
+    }
+    // copy parameters
+    for ( size_t count = 0; count < argv_count; count++ ) {
+      len = strlen( argv[ count ] ) + 1;
+      tmp_argv[ count + idx ] = malloc( len );
+      if ( ! tmp_argv[ count + idx ] ) {
+        for ( size_t free_idx = 0; free_idx < argv_count; free_idx++ ) {
+          free( tmp_argv[ free_idx ] );
+        }
+        free( tmp_argv );
+        free( interp );
+        free( image );
+        errno = ENOMEM;
+        return -1;
+      }
+      memcpy( tmp_argv[ count + idx ], argv[ count ], len );
+    }
+    tmp_argv[ argv_count + idx ] = NULL;
+  }
+  // replace process
+  _syscall_process_replace( ( void* )image, tmp_argv, ( char** )env );
+  // clear image and interpreter string
+  free( interp );
+  free( image );
+  // set errno if not already set
+  if ( ! errno ) {
+    errno = ENOEXEC;
+  }
+  return -1;
+}
diff --git newlib/libc/sys/bolthur/syscall/syscall-exit.c newlib/libc/sys/bolthur/syscall/syscall-exit.c
new file mode 100644
index 000000000..22192eeec
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-exit.c
@@ -0,0 +1,81 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdlib.h>
+#include <unistd.h>
+#include <stdnoreturn.h>
+#include <errno.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn void _exit(int)
+ * @brief Exit implementation
+ *
+ * @param status exit status code
+ *
+ * @todo remove __weak_symbol once finished
+ * @todo send exit status to parent?
+ */
+__weak_symbol noreturn void _exit( int status ) {
+  // send close request to vfs
+  if ( VFS_DAEMON_ID != getpid() ) {
+    // allocate response until it worked
+    vfs_close_response_t* response;
+    do {
+      response = malloc( sizeof( vfs_close_response_t ) );
+    } while ( ! response );
+    // try to close until successful response comes back
+    bool raise = true;
+    do {
+      // raise rpc and wait for return
+      size_t response_id;
+      if ( raise ) {
+        response_id = bolthur_rpc_raise(
+          RPC_VFS_EXIT,
+          VFS_DAEMON_ID,
+          NULL,
+          0,
+          NULL,
+          VFS_DAEMON_ID,
+          NULL,
+          0,
+          0,
+          0,
+          NULL
+        );
+      }
+      if ( 0 == response_id ) {
+        continue;
+      }
+      // set flag to false
+      if ( raise ) {
+        raise = false;
+      }
+      // get response
+      memset( response, 0, sizeof( vfs_close_response_t ) );
+      _syscall_rpc_get_data(
+        response,
+        sizeof( vfs_close_response_t ),
+        response_id,
+        false
+      );
+      if ( errno ) {
+        continue;
+      }
+      // set raise to true again
+      raise = true;
+    } while ( 0 != response->status );
+    // free response
+    free( response );
+  }
+  // FIXME: send exit status to parent process which may be wait for this one
+  // call process exit
+  _syscall_process_exit();
+}
