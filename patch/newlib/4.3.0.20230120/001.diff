+// global to prevent malloc in default handler
+static vfs_read_response_t read_response;
+
+/**
+ * @fn void handle_rpc(void*, size_t, size_t, size_t, size_t)
+ * @brief Helper to perform rpc return with cleanup
+ *
+ * @param response_data
+ * @param response_size
+ * @param rpc_data_info
+ * @param rpc_response_info
+ * @param rpc_type
+ */
+static void handle_rpc(
+  void* response_data,
+  size_t response_size,
+  size_t rpc_data_info,
+  size_t rpc_response_info,
+  size_t rpc_type
+) {
+  bolthur_async_data_t* async_data = NULL;
+  // handle async stuff
+  if ( rpc_response_info ) {
+    // try to get matching async data
+    async_data = bolthur_rpc_pop_async( rpc_type, rpc_response_info );
+    // handle no data
+    if( rpc_data_info ) {
+      // fetch response
+      _syscall_rpc_get_data( response_data, response_size, rpc_data_info, false );
+      // reset data info when there was no error
+      if ( ! errno ) {
+        rpc_data_info = 0;
+      }
+    }
+  }
+  // remove data
+  if ( rpc_data_info ) {
+    _syscall_rpc_clear_data( rpc_data_info );
+  }
+  // return
+  if ( response_data ) {
+    bolthur_rpc_return( rpc_type, response_data, response_size, async_data );
+  }
+}
