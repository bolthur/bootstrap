+#define _SYS_BOLTHUR_PRINT_H
+
+#if ! defined( PROGRAM_NAME )
+#define PROGRAM_NAME "unknown"
+#endif
+// necessary hack to prevent useless warning?
+#if defined( __cppcheck__ )
+  #define FUNC_WRAPPER __func__ ? __func__ : "unknown"
+#else
+  #define FUNC_WRAPPER __func__
+#endif
+
+#define EARLY_STARTUP_PRINT( ... ) \
+  { \
+    char count_buffer[ 8 ]; \
+    volatile size_t count_buffer_size = 7; \
+    int int_digit_prefix = snprintf( \
+      count_buffer, \
+      count_buffer_size, "[ %s ][ %s:%5d ] ", \
+      PROGRAM_NAME, FUNC_WRAPPER, __LINE__ \
+    ); \
+    if ( 0 > int_digit_prefix ) { \
+      exit( 1 ); \
+    } \
+    int int_digit_suffix = snprintf( \
+      count_buffer, count_buffer_size, __VA_ARGS__ ); \
+    if ( 0 > int_digit_suffix ) { \
+      exit( 1 ); \
+    } \
+    size_t digit_suffix = ( size_t )int_digit_suffix; \
+    size_t digit_prefix = ( size_t )int_digit_prefix; \
+    size_t total_digit = digit_prefix + digit_suffix + 1; \
+    char* tmp_buffer = malloc( sizeof( char ) * total_digit ); \
+    if ( ! tmp_buffer ) { \
+      exit( 1 ); \
+    } \
+    memset( tmp_buffer, 0, sizeof( char ) * total_digit ); \
+    snprintf( tmp_buffer, total_digit, "[ %s ][ %s:%5d ] ", \
+      PROGRAM_NAME, FUNC_WRAPPER, __LINE__ ); \
+    snprintf( tmp_buffer + digit_prefix, total_digit - digit_prefix, \
+      __VA_ARGS__ ); \
+    _syscall_kernel_puts( tmp_buffer, total_digit - 1 ); \
+    free( tmp_buffer ); \
+  }
+
+#define STARTUP_PRINT( ... ) \
+  { \
+    printf("[ %s ][ %s:%5d ] ", PROGRAM_NAME, FUNC_WRAPPER, __LINE__ ); \
+    printf( __VA_ARGS__ ); \
+  }
+
+#endif
diff --git newlib/libc/sys/bolthur/sys/bolthur/rpc.h newlib/libc/sys/bolthur/sys/bolthur/rpc.h
new file mode 100644
index 000000000..981c85b44
--- /dev/null
+++ newlib/libc/sys/bolthur/sys/bolthur/rpc.h
@@ -0,0 +1,243 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#ifndef _SYS_BOLTHUR_H
+#error "Never use <sys/bolthur/rpc.h> directly; include <sys/bolthur.h> instead."
+#endif
+
+#ifndef _SYS_BOLTHUR_RPC_H
+#define _SYS_BOLTHUR_RPC_H
+
+__BEGIN_DECLS
+
+typedef void ( *rpc_handler_t )( size_t, pid_t, size_t, size_t );
+
+typedef struct {
+  size_t type;
+  size_t rpc_id;
+  size_t length;
+  void* original_data;
+  pid_t original_origin;
+  size_t original_rpc_id;
+  rpc_handler_t callback;
+  void* context;
+} bolthur_async_data_t;
+
+// Interrupts are stored within uint8_t that starts with 0 and uses max uint8 value
+#define RPC_INTERRUPT_START 0
+#define RPC_INTERRUPT_END UINT8_MAX
+// Signals are starting directly after interrupts
+#define RPC_SIGNAL_START RPC_INTERRUPT_END + 1
+#define RPC_SIGNAL_END RPC_SIGNAL_START + NSIG - 1
+// special timer rpc, e.g. timer expired
+#define RPC_TIMER RPC_SIGNAL_END + 1
+// necessary VFS rpc types
+#define RPC_VFS_ADD RPC_TIMER + 1
+#define RPC_VFS_REMOVE RPC_VFS_ADD + 1
+#define RPC_VFS_OPEN RPC_VFS_REMOVE + 1
+#define RPC_VFS_CLOSE RPC_VFS_OPEN + 1
+#define RPC_VFS_READ RPC_VFS_CLOSE + 1
+#define RPC_VFS_WRITE RPC_VFS_READ + 1
+#define RPC_VFS_SEEK RPC_VFS_WRITE + 1
+#define RPC_VFS_STAT RPC_VFS_SEEK + 1
+#define RPC_VFS_IOCTL RPC_VFS_STAT + 1
+#define RPC_VFS_FORK RPC_VFS_IOCTL + 1
+#define RPC_VFS_EXIT RPC_VFS_FORK + 1
+#define RPC_VFS_MOUNT RPC_VFS_EXIT + 1
+#define RPC_VFS_UMOUNT RPC_VFS_MOUNT + 1
+#define RPC_VFS_WATCH_REGISTER RPC_VFS_UMOUNT + 1
+#define RPC_VFS_WATCH_RELEASE RPC_VFS_WATCH_REGISTER + 1
+#define RPC_VFS_WATCH_NOTIFY RPC_VFS_WATCH_RELEASE + 1
+#define RPC_VFS_GETDENTS RPC_VFS_WATCH_NOTIFY + 1
+#define RPC_VFS_REGISTER_HANDLER RPC_VFS_GETDENTS + 1
+#define RPC_VFS_RELEASE_HANDLER RPC_VFS_REGISTER_HANDLER + 1
+#define RPC_VFS_BOOT_INIT RPC_VFS_RELEASE_HANDLER + 1
+// custom rpc type start
+#define RPC_CUSTOM_START RPC_VFS_BOOT_INIT + 10
+
+#if defined( _COMPILING_NEWLIB )
+  void _bolthur_rpc_bind_r( struct _reent* r, size_t num, rpc_handler_t handler, bool overwrite );
+  void _bolthur_rpc_unbind_r( struct _reent* r, size_t num, rpc_handler_t handler );
+  rpc_handler_t _bolthur_rpc_get_r( struct _reent* r, size_t num );
+  bool _bolthur_rpc_push_async_r( struct _reent* r,  size_t num, size_t rpc_id, void* data, size_t length, pid_t origin, size_t original_rpc_id, rpc_handler_t callback, void* context );
+  rpc_handler_t _bolthur_rpc_async_callback_r( size_t num, size_t rpc_id );
+  bolthur_async_data_t* _bolthur_rpc_pop_async_r( struct _reent* r, size_t num, size_t rpc_id );
+  bool _bolthur_rpc_has_async_r( size_t num, size_t rpc_id );
+  void _bolthur_rpc_destroy_async_r( struct _reent* r, bolthur_async_data_t* async );
+  bool _bolthur_rpc_validate_origin_r( struct _reent* r, pid_t origin, size_t data_id );
+  void _bolthur_rpc_return_r( struct _reent* r, size_t type, void* data, size_t length, bolthur_async_data_t* async );
+  void _bolthur_rpc_wait_block_r( struct _reent* r );
+  size_t _bolthur_rpc_raise_generic_r( struct _reent* r, size_t type, pid_t target, void* data, size_t length, rpc_handler_t callback, bool ignore_response, size_t save_type, void* save_data, size_t save_length, pid_t save_origin, size_t save_data_id, void* context, bool no_return );
+  size_t _bolthur_rpc_raise_r( size_t type, pid_t target, void* data, size_t length, rpc_handler_t callback, size_t save_type, void* save_data, size_t save_length, pid_t save_origin, size_t save_data_id, void* context );
+#endif
+
+/**
+ * @fn void bolthur_rpc_bind(size_t, rpc_handler_t, bool)
+ * @brief bind rpc handler with type
+ *
+ * @param num rpc type to bind
+ * @param handler handler to use
+ * @param overwrite overwrite existing handler
+ */
+void bolthur_rpc_bind( size_t num, rpc_handler_t handler, bool overwrite );
+
+/**
+ * @fn void bolthur_rpc_unbind(size_t, rpc_handler_t)
+ * @brief unbind rpc handler with type
+ *
+ * @param num rpc type to unbind
+ * @param handler handler to unbind
+ */
+void bolthur_rpc_unbind( size_t num, rpc_handler_t handler );
+
+/**
+ * @fn rpc_handler_t bolthur_rpc_unbind(size_t)
+ * @brief get bound rpc handler by type
+ *
+ * @param num rpc type to get handler for
+ * @return NULL if not found or registered handler
+ */
+rpc_handler_t bolthur_rpc_get( size_t num );
+
+/**
+ * @fn bool bolthur_rpc_push_async(size_t, size_t, void*, size_t, pid_t, rpc_handler_t, void*)
+ * @brief Push async request to list
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @param data original request
+ * @param length original request length
+ * @param origin original origin
+ * @param original_rpc_id original rpc id
+ * @param callback callback to call on answer
+ * @param context additional data to be stored
+ * @return true on success or false on error
+ *
+ * @exception ENOMEM Not enough element to return found item or rebuild item list
+ */
+bool bolthur_rpc_push_async( size_t num, size_t rpc_id, void* data, size_t length, pid_t origin, size_t original_rpc_id, rpc_handler_t callback, void* context );
+
+/**
+ * @fn bolthur_async_data_t* bolthur_rpc_pop_async(size_t, size_t)
+ * @brief pop async data by type and rpc id
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @return async request info or NULL if not existing
+ *
+ * @exception ENOMEM Not enough element to return found item or rebuild item list
+ */
+bolthur_async_data_t* bolthur_rpc_pop_async( size_t num, size_t rpc_id );
+
+/**
+ * @fn rpc_handler_t bolthur_rpc_async_callback(size_t)
+ * @brief Helper to get rpc async callback by rpc id
+ *
+ * @param rpc_id
+ * @return
+ */
+rpc_handler_t bolthur_rpc_async_callback( size_t rpc_id );
+
+/**
+ * @fn bool bolthur_rpc_has_async(size_t, size_t)
+ * @brief helper to check for async data by type and rpc id
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @return bool
+ */
+bool bolthur_rpc_has_async( size_t num, size_t rpc_id );
+
+/**
+ * @fn void bolthur_rpc_destroy_async(bolthur_async_data_t*)
+ * @brief Destroy async data
+ *
+ * @param async data to destroy
+ */
+void bolthur_rpc_destroy_async( bolthur_async_data_t* async );
+
+/**
+ * @fn bool bolthur_rpc_validate_origin(pid_t, size_t)
+ * @brief Helper to validate rpc origin against vfs id
+ *
+ * @param origin origin to validate
+ * @param data_id rpc data id to delete if not valid
+ * @return true if valid, else false
+ */
+bool bolthur_rpc_validate_origin( pid_t origin, size_t data_id );
+
+/**
+ * @fn void bolthur_rpc_return(size_t,void*,size_t,bolthur_async_data_t*)
+ * @brief Return from rpc
+ *
+ * @param type return type
+ * @param data return data
+ * @param length return length
+ * @param async async data container or NULL
+ *
+ * @see _syscall_rpc_ret
+ */
+void bolthur_rpc_return( size_t type, void* data, size_t length, bolthur_async_data_t* async );
+
+/**
+ * @fn void bolthur_rpc_wait_block(void)
+ * @brief Wait with block for rpc
+ *
+ * @see _syscall_rpc_wait_for_call
+ */
+void bolthur_rpc_wait_block( void );
+
+/**
+ * @fn size_t bolthur_rpc_raise_generic(size_t, pid_t, void*, size_t, rpc_handler_t, size_t, void*, size_t, pid_t, size_t, void*, bool)
+ * @brief Perform rpc
+ *
+ * @param type rpc type
+ * @param target target process
+ * @param data data to send
+ * @param length data size
+ * @param callback callback to use (async request if not NULL)
+ * @param save_type type to save for async handling
+ * @param save_data data to save for async handling
+ * @param save_length save data size to save for async handling
+ * @param save_origin origin process
+ * @param save_data_id rpc data id where raise is called within
+ * @param context additional data to be stored
+ * @param no_return raise rpc without return
+ * @return size_t response id if synchronous request, else 0
+ *
+ * @see _syscall_rpc_raise
+ * @see bolthur_rpc_push_async
+ */
+size_t bolthur_rpc_raise_generic( size_t type, pid_t target, void* data, size_t length, rpc_handler_t callback, size_t save_type, void* save_data, size_t save_length, pid_t save_origin, size_t save_data_id, void* context, bool no_return );
+
+/**
+ * @fn size_t bolthur_rpc_raise(size_t, pid_t, void*, size_t, rpc_handler_t, size_t, void*, size_t, pid_t, size_t, void*)
+ * @brief Perform rpc
+ *
+ * @param type rpc type
+ * @param target target process
+ * @param data data to send
+ * @param length data size
+ * @param callback callback to use (async request if not NULL)
+ * @param save_type type to save for async handling
+ * @param save_data data to save for async handling
+ * @param save_length save data size to save for async handling
+ * @param save_origin origin process
+ * @param save_data_id rpc data id where raise is called within
+ * @param context additional data to be stored
+ * @return size_t response id if synchronous request, else 0
+ *
+ * @see _syscall_rpc_raise
+ * @see bolthur_rpc_push_async
+ */
+size_t bolthur_rpc_raise( size_t type, pid_t target, void* data, size_t length, rpc_handler_t callback, size_t save_type, void* save_data, size_t save_length, pid_t save_origin, size_t save_data_id, void* context );
+
+__END_DECLS
+
+#endif
diff --git newlib/libc/sys/bolthur/sys/bolthur/syscall.h newlib/libc/sys/bolthur/sys/bolthur/syscall.h
new file mode 100644
index 000000000..2a6b9012f
--- /dev/null
+++ newlib/libc/sys/bolthur/sys/bolthur/syscall.h
@@ -0,0 +1,419 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#ifndef _SYS_BOLTHUR_H
+#error "Never use <sys/bolthur/syscall.h> directly; include <sys/bolthur.h> instead."
+#endif
+
+#ifndef _SYS_BOLTHUR_SYSCALL_H
+#define _SYS_BOLTHUR_SYSCALL_H
+
+#define MEMORY_ACQUIRE_PROTECTION_NONE 0x0
+#define MEMORY_ACQUIRE_PROTECTION_READ 0x1
+#define MEMORY_ACQUIRE_PROTECTION_WRITE 0x2
+#define MEMORY_ACQUIRE_PROTECTION_EXECUTABLE 0x4
+
+#define MEMORY_ACQUIRE_FLAG_NONE 0x0
+#define MEMORY_ACQUIRE_FLAG_PHYS 0x1
+#define MEMORY_ACQUIRE_FLAG_DEVICE 0x2
+#define MEMORY_ACQUIRE_FLAG_BUS 0x4
+
+#define MEMORY_SHARED_ACCESS_READ 0x1
+#define MEMORY_SHARED_ACCESS_WRITE 0x2
+
+__BEGIN_DECLS
+
+/**
+ * @fn void _syscall_process_exit(int)
+ * @brief Process exit
+ */
+extern void __attribute__((__noreturn__)) _syscall_process_exit( void  );
+
+/**
+ * @fn pid_t _syscall_process_id(void)
+ * @brief Get process id
+ *
+ * @return process id
+ */
+extern pid_t _syscall_process_id( void );
+
+/**
+ * @fn pid_t _syscall_process_parent_id(void)
+ * @brief Get parent process id of current process
+ *
+ * @return process id of parent or 0 if there is no parent
+ */
+extern pid_t _syscall_process_parent_id( void );
+
+/**
+ * @fn pid_t _syscall_process_fork(void)
+ * @brief Create fork of current process
+ *
+ * @return pid of the fork for new process and 0 for current process
+ *
+ * @exception ENOMEM fork failed due to lack of memory or some other error
+ */
+extern pid_t _syscall_process_fork( void );
+
+/**
+ * @fn pid_t _syscall_process_replace(void*, char**, char**)
+ * @brief Replace current process image with provided one
+ *
+ * @param image pointer to image used for replace
+ * @param argv argv data for replaced image
+ * @param env env data for replaced image
+ *
+ * @exception EINVAL invalid data has been passed
+ * @exception ENOMEM not enough memory existing
+ */
+extern void _syscall_process_replace( void* image, char** argv, char** env );
+
+/**
+ * @fn pid_t _syscall_process_parent_by_id(pid_t)
+ * @brief Get parent process id of given process id
+ *
+ * @param process process to request parent for
+ * @return parent process id
+ *
+ * @exception EINVAL invalid process has been provided
+ */
+extern pid_t _syscall_process_parent_by_id( pid_t process );
+
+/**
+ * @fn bool _syscall_process_exist(pid_t)
+ * @brief Check if process exist by pid
+ *
+ * @param process process to check
+ * @return true if existing, else false
+ *
+ * @exception EINVAL invalid process has been provided
+ */
+extern bool _syscall_process_exist( pid_t process );
+
+/**
+ * @fn pid_t _syscall_thread_create(uintptr_t, void*)
+ * @brief Create new thread
+ *
+ * @param entry entry point for new thread
+ * @param argument pointer to argument block passed as single parameter to thread
+ * @return id of new thread
+ *
+ * @exception EIO something went wrong during thread creation
+ */
+extern pid_t _syscall_thread_create( uintptr_t entry, void* argument );
+
+/**
+ * @fn void _syscall_thread_exit(int)
+ * @brief Exit current running thread
+ */
+extern void __attribute__((__noreturn__)) _syscall_thread_exit( void );
+
+/**
+ * @fn pid_t _syscall_thread_id(void)
+ * @brief Get current running thread id
+ *
+ * @return id of current running thread
+ */
+extern pid_t _syscall_thread_id( void );
+
+/**
+ * @fn void _syscall_memory_acquire*(void*, size_t, int)
+ * @brief Acquire memory
+ *
+ * @param address address where new memory shall be mapped as start or 0
+ * @param length memory amount to acquire ( will be rounded up to full page )
+ * @param protection memory protection
+ * @param flag memory acquire flag
+ *
+ * @exception EINVAL invalid parameters have been passed
+ * @exception ENOMEM not enough memory existing, invalid start address or mapping failed
+ * @exception EIO Mapping failed
+ * @exception EADDRINUSE address is already in use in case map physical was set
+ */
+extern void* _syscall_memory_acquire( void* address, size_t length, int protection, int flag );
+
+/**
+ * @fn int _syscall_memory_release(void*, size_t)
+ * @brief Release acquired memory
+ *
+ * @param address address to release
+ * @param length memory amount to be released ( will be rounded up to full page )
+ *
+ * @exception EINVAL invalid data has been passed
+ * @exception EADDRNOTAVAIL tried to release shared memory
+ * @exception EIO Unmapping failed
+ */
+extern void _syscall_memory_release( void* address, size_t length );
+
+/**
+ * @fn size_t _syscall_memory_shared_create(size_t)
+ * @brief Ceate new shared area
+ *
+ * @param length shared area size
+ * @return shared area id
+ *
+ * @exception EINVAL invalid parameter has been passed
+ * @exception ENOMEM unable to create shared area
+ */
+extern size_t _syscall_memory_shared_create( size_t length );
+
+/**
+ * @fn void _syscall_memory_shared_attach*(size_t, uintptr_t)
+ * @brief Attach shared memory area by id to address
+ *
+ * @param shared_memory_id shared memory id to attach
+ * @param address start address to use for mapping
+ * @return address where shared area has been mapped
+ *
+ * @exception ENOMEM unable to attach shared memory
+ */
+extern void* _syscall_memory_shared_attach( size_t shared_memory_id, uintptr_t address );
+
+/**
+ * @fn void _syscall_memory_shared_detach(size_t)
+ * @brief Detach shared memory area by id
+ *
+ * @param shared_memory_id shared memory id to detach
+ *
+ * @exception EIO unable to detach shared memory by id
+ */
+extern void _syscall_memory_shared_detach( size_t shared_memory_id );
+
+/**
+ * @fn void _syscall_memory_shared_size(size_t)
+ * @brief Get size of a shared memory area by id
+ *
+ * @param shared_memory_id shared memory id to get size of
+ *
+ * @exception EINVAL invalid memory id passed
+ */
+extern size_t _syscall_memory_shared_size( size_t shared_memory_id );
+
+/**
+ * @fn void _syscall_memory_translate_physical(uintptr_t)
+ * @brief Translates virtual into physical address
+ *
+ * @param address address to translate
+ *
+ * @exception EINVAL invalid address has been passed
+ */
+extern uintptr_t _syscall_memory_translate_physical( uintptr_t address );
+
+/**
+ * @fn void _syscall_memory_translate_bus(uintptr_t, size_t)
+ * @brief Translates virtual address into physical bus address
+ *
+ * @param address address to translate
+ * @param size size of address range
+ *
+ * @exception EINVAL invalid address has been passed
+ */
+extern uintptr_t _syscall_memory_translate_bus( uintptr_t address, size_t size );
+
+/**
+ * @fn void _syscall_rpc_set_handler(uintptr_t)
+ * @brief Set main rpc handler entry
+ *
+ * @param handler entry point for incoming rpc requests
+ *
+ * @exception EAGAIN error during prepare of process for rpc or during detach of rpc
+ */
+extern void _syscall_rpc_set_handler( uintptr_t handler );
+
+/**
+ * @fn size_t _syscall_rpc_raise(size_t, pid_t, void*, size_t, bool)
+ * @brief Raise synchronous rpc call with wait for response ( blocks current process until return )
+ *
+ * @param type rpc type
+ * @param process target process that provides identifier callback
+ * @param data address to rpc data block ( shall be NULL in case of no data )
+ * @param length rpc data block length ( shall be 0 in case of no data )
+ * @param origin_rpc_id origin rpc id necessary for async = true
+ * @param sync perform synchronous blocking rpc
+ * @param no_return perform rpc raise without return
+ * @return rpc data id of response if sync is set to true. If false it contains the data id of new rpc for allow handling of answers
+ *
+ * @exception EINVAL invalid parameters have been passed
+ * @exception EAGAIN error during prepare of process for rpc
+ * @exception ENOMEM not enough memory
+ * @exception EIO unsafe copy of memory failed
+ */
+extern size_t _syscall_rpc_raise( size_t type, pid_t process, void* data, size_t length, size_t origin_rpc_id, bool sync, bool no_return );
+
+/**
+ * @fn void _syscall_rpc_ret(size_t, void*, size_t, size_t)
+ * @brief Push rpc return data and unblock source process waiting for return
+ *
+ * @param type return data type
+ * @param data address to return data block
+ * @param length data block length
+ * @param original_rpc_id original rpc id ( useful for async rpc responses )
+ *
+ * @exception EINVAL invalid parameters have been passed
+ * @exception EAGAIN no active rpc information found
+ * @exception ESRCH source process not waiting for any response
+ * @exception ENOMEM not enough memory
+ * @exception EIO unsafe copy failed
+ */
+extern void _syscall_rpc_ret( size_t type, void* data, size_t length, size_t original_rpc_id );
+
+/**
+ * @fn void _syscall_rpc_get_data(void*, size_t, size_t, bool)
+ * @brief Get rpc data block by id
+ *
+ * @param data address to copy content to
+ * @param length data maximum length
+ * @param rpc_data_id rpc data id
+ * @param peek peek data without removal
+ *
+ * @exception EINVAL invalid parameters passed or process has not been setup for rpc completely
+ * @exception ENOMSG no data block found for given id
+ * @exception EMSGSIZE data block size greater than given data length
+ * @exception ENOMEM not enough memory internally
+ * @exception EIO internal removal if unsafe copy failed
+ */
+extern void _syscall_rpc_get_data( void* data, size_t length, size_t rpc_data_id, bool peek );
+
+/**
+ * @fn size_t _syscall_rpc_get_data_size(size_t)
+ * @brief Get size of rpc data block
+ *
+ * @param rpc_data_id if of rpc data block
+ * @return rpc data block length
+ *
+ * @exception EINVAL process has not been setup for rpc completely
+ * @exception ENOMSG no data block found for given id
+ */
+extern size_t _syscall_rpc_get_data_size( size_t rpc_data_id );
+
+/**
+ * @fn void _syscall_rpc_wait_for_call(void)
+ * @brief Wait for new rpc
+ *
+ * @exception EAGAIN thread is not normally active, e.g. called from within rpc
+ */
+extern void _syscall_rpc_wait_for_call( void );
+
+/**
+ * @fn void _syscall_rpc_set_ready(bool)
+ * @brief Set rpc ready flag to enable rpc calls to process
+ *
+ * @param ready true if ready, else false
+ */
+extern void _syscall_rpc_set_ready( bool ready );
+
+/**
+ * @fn void _syscall_rpc_end(bool)
+ * @brief Rpc end call
+ */
+extern void _syscall_rpc_end( void );
+
+/**
+ * @fn void _syscall_rpc_wait_for_ready(pid_t)
+ * @brief Wait for process to be ready for rpc
+ *
+ * @param process process to wait for
+ *
+ * @exception ESRCH process not existing
+ * @exception EINVAL process is not a child of current process
+ */
+extern void _syscall_rpc_wait_for_ready( pid_t process );
+
+/**
+ * @fn void _syscall_rpc_clear_data(size_t)
+ * @brief Remove rpc data of process
+ *
+ * @param rpc_data_id rpc data to remove
+ */
+extern void _syscall_rpc_clear_data( size_t rpc_data_id );
+
+/**
+ * @fn void _syscall_interrupt_acquire(uint8_t)
+ * @brief Register process for interrupt number as handler
+ *
+ * @param num interrupt number
+ *
+ * @exception EINVAL invalid interrupt number
+ * @exception EAGAIN no rpc handler set or error while adding interrupt handler
+ */
+extern void _syscall_interrupt_acquire( uint8_t num );
+
+/**
+ * @fn void _syscall_interrupt_acquire(uint8_t)
+ * @brief Unregister process for interrupt number as handler
+ *
+ * @param num interrupt number
+ *
+ * @exception EINVAL invalid interrupt number
+ * @exception EAGAIN error while removing interrupt handler
+ */
+extern void _syscall_interrupt_release( uint8_t num );
+
+/**
+ * @fn size_t _syscall_timer_tick_count(void)
+ * @brief Get current timer tick count
+ *
+ * @return current timer tick count value
+ */
+extern size_t _syscall_timer_tick_count( void );
+
+/**
+ * @fn size_t _syscall_timer_frequency(void)
+ * @brief Get timer frequency
+ *
+ * @return used timer frequency
+ */
+extern size_t _syscall_timer_frequency( void );
+
+/**
+ * @fn size_t _syscall_timer_acquire(size_t, size_t)
+ * @brief Acquire timeout
+ *
+ * @param type timeout rpc type
+ * @param timeout ticks until process will be blocked
+ * @return
+ */
+extern size_t _syscall_timer_acquire( size_t type, size_t timeout );
+
+/**
+ * @fn void _syscall_timer_release(size_t)
+ * @brief Release previously acquired timer by id
+ *
+ * @param timer_id timer to release
+ *
+ * @exception EAGAIN error while releasing given timer
+ */
+extern void _syscall_timer_release( size_t timer_id );
+
+/**
+ * @fn void _syscall_kernel_putc(uint8_t)
+ * @brief Print a character via kernel
+ *
+ * @param c character to put
+ * @return amount of printed characters
+ */
+extern int _syscall_kernel_putc( uint8_t c );
+
+/**
+ * @fn int _syscall_kernel_puts(char*, size_t)
+ * @brief Print string via kernel
+ *
+ * @param str string to print
+ * @param length string length
+ * @return amount of printed characters
+ *
+ * @exception EINVAL invalid parameters have been passed
+ * @exception ENOMEM not enough memory
+ * @exception EIO unsage memory copy failed
+ */
+extern int _syscall_kernel_puts( char* str, size_t length );
+
+__END_DECLS
+
+#endif
diff --git newlib/libc/sys/bolthur/sys/bolthur/vfs.h newlib/libc/sys/bolthur/sys/bolthur/vfs.h
new file mode 100644
index 000000000..31981728e
--- /dev/null
+++ newlib/libc/sys/bolthur/sys/bolthur/vfs.h
@@ -0,0 +1,228 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#ifndef _SYS_BOLTHUR_H
+#error "Never use <sys/bolthur/vfs.h> directly; include <sys/bolthur.h> instead."
+#endif
+
+#ifndef _SYS_BOLTHUR_VFS_H
+#define _SYS_BOLTHUR_VFS_H
+
+#define VFS_DAEMON_ID 2
+
+__BEGIN_DECLS
+
+typedef struct __packed {
+  char file_path[ PATH_MAX ];
+  char linked_path[ PATH_MAX ];
+  struct stat info;
+  pid_t handler;
+  size_t device_info[];
+} vfs_add_request_t;
+
+typedef struct __packed {
+  vfs_add_status_t status;
+  pid_t handler;
+} vfs_add_response_t;
+
+typedef struct __packed {
+  char path[ PATH_MAX ];
+} vfs_remove_request_t;
+
+typedef struct __packed {
+  int status;
+} vfs_remove_response_t;
+
+typedef struct __packed {
+  char path[ PATH_MAX ];
+  int flags;
+  int mode;
+  int handle; // filled internally
+  pid_t origin; // filled internally
+} vfs_open_request_t;
+
+typedef struct __packed {
+  int handle;
+  struct stat st;
+  pid_t handler;
+} vfs_open_response_t;
+
+typedef struct __packed {
+  int handle;
+  pid_t origin; // filled internally
+} vfs_close_request_t;
+
+typedef struct __packed {
+  int status;
+} vfs_close_response_t;
+
+typedef struct __packed {
+  int handle;
+  size_t len;
+  off_t offset;
+  char file_path[ PATH_MAX ];
+  size_t shm_id; // shared memory id for bigger read requests
+  pid_t target_process; // filled internally
+  pid_t origin; // filled internally
+} vfs_read_request_t;
+
+typedef struct __packed {
+  ssize_t len;
+} vfs_read_response_t;
+
+typedef struct __packed {
+  int handle;
+  char data[ MAX_WRITE_LEN ];
+  size_t len;
+  off_t offset;
+  // Necessary for inner requests to pass file paths to handling processes
+  char file_path[ PATH_MAX ];
+  size_t shm_id; // shared memory id for bigger write requests
+  pid_t target_process; // filled internally
+  pid_t origin; // filled internally
