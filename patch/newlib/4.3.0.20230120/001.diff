index 000000000..402a0d533
--- /dev/null
+++ libgloss/arm/bolthur-system-call1.c
@@ -0,0 +1,36 @@
+
+/**
+ * Bolthur system call numbers for the ARM processor.
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/fcntl.h>
+#include <sys/times.h>
+#include <sys/errno.h>
+#include <sys/time.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <errno.h>
+
+/**
+ * @brief Set errno if set from system call
+ *
+ * @param n
+ * @return int
+ */
+int _set_errno( int val, int err ) {
+  // sett errno and return -1
+  if ( err < 0 ) {
+    errno = -err;
+    return -1;
+  }
+  // unset errno and return value
+  errno = 0;
+  return val;
+}
