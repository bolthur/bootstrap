diff --git newlib/libc/sys/bolthur/unix/grp.c newlib/libc/sys/bolthur/unix/grp.c
new file mode 100644
index 000000000..e4fa1ec25
--- /dev/null
+++ newlib/libc/sys/bolthur/unix/grp.c
@@ -0,0 +1,208 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <grp.h>
+#include <paths.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+static FILE* grp_fd = NULL;
+static char buffer[ 1024 ];
+
+__weak_symbol struct group* getgrent( void ) {
+  static struct group entry = {
+    .gr_name = NULL,
+    .gr_passwd = NULL,
+    .gr_gid = ( gid_t )-1,
+    .gr_mem = NULL,
+  };
+  // handle no open file
+  if ( ! grp_fd ) {
+    return NULL;
+  }
+  // try to read
+  if ( ! fgets( buffer, sizeof( buffer ), grp_fd ) ) {
+    return NULL;
+  }
+  // clear entry pointers if set
+  if ( entry.gr_name ) {
+    free( entry.gr_name );
+    entry.gr_name = NULL;
+  }
+  if ( entry.gr_passwd ) {
+    free( entry.gr_passwd );
+    entry.gr_passwd = NULL;
+  }
+  if ( entry.gr_mem ) {
+    for ( size_t idx = 0; entry.gr_mem[ idx ]; idx++ ) {
+      free( entry.gr_mem[ idx ] );
+      entry.gr_mem[ idx ] = NULL;
+    }
+    free( entry.gr_mem );
+    entry.gr_mem = NULL;
+  }
+  entry.gr_gid = ( gid_t )-1;
+  // strip out newline and possible carriage return
+  if ( '\n' == buffer[ strlen( buffer ) - 1 ] ) {
+    buffer[ strlen( buffer ) - 1 ] = '\0';
+  }
+  if ( '\r' == buffer[ strlen( buffer ) - 1 ] ) {
+    buffer[ strlen( buffer ) - 1 ] = '\0';
+  }
+  // loop through parts
+  char* part = NULL;
+  char* last_part = NULL;
+  for (
+    part = strtok_r( buffer, ":", &last_part );
+    part;
+    part = strtok_r( NULL, ":", &last_part )
+  ) {
+    // handle name
+    if ( ! entry.gr_name ) {
+      entry.gr_name = strdup( part );
+      if ( ! entry.gr_name ) {
+        return NULL;
+      }
+    // handle passwd
+    } else if ( ! entry.gr_passwd ) {
+      entry.gr_passwd = strdup( part );
+      if ( ! entry.gr_passwd ) {
+        return NULL;
+      }
+    // handle gid
+    } else if ( ( gid_t )-1 == entry.gr_gid ) {
+      char* dup = strdup( part );
+      if ( ! dup ) {
+        return NULL;
+      }
+      entry.gr_gid = ( gid_t )strtol( dup, NULL, 10 );
+      free( dup );
+    // handle member
+    } else {
+      if ( strchr( part, ',' ) ) {
+        // duplicate part
+        char* p = strdup( part );
+        if ( ! p ) {
+          return NULL;
+        }
+        // loop and count entries
+        char* part2 = NULL;
+        char* last_part2 = NULL;
+        size_t count = 0;
+        for (
+          part2 = strtok_r( p, ",", &last_part2 );
+          part2;
+          part2 = strtok_r( NULL, ",", &last_part2 )
+        ) {
+          count++;
+        }
+        // free duplicate
+        free( p );
+        // add null termination entry
+        count++;
+        // allocate space
+        entry.gr_mem = malloc( count * sizeof( char* ) );
+        if ( ! entry.gr_mem ) {
+          return NULL;
+        }
+        memset( entry.gr_mem, 0, count * sizeof( char* ) );
+        // reset last part and part
+        last_part2 = NULL;
+        part2 = NULL;
+        size_t idx = 0;
+        for (
+          part2 = strtok_r( part, ",", &last_part2 );
+          part2;
+          part2 = strtok_r( NULL, ",", &last_part2 ), idx++
+        ) {
+          char* dup = strdup( part2 );
+          if ( ! dup ) {
+            return NULL;
+          }
+          entry.gr_mem[ idx ] = dup;
+        }
+      } else {
+        // allocate space
+        entry.gr_mem = malloc( 2 * sizeof( char* ) );
+        if ( ! entry.gr_mem ) {
+          return NULL;
+        }
+        memset( entry.gr_mem, 0, 2 * sizeof( char* ) );
+        char* dup = strdup( part );
+        if ( ! dup ) {
+          return NULL;
+        }
+        entry.gr_mem[ 0 ] = dup;
+      }
+    }
+  }
+  // return entry
+  return &entry;
+}
+
+__weak_symbol void setgrent( void ) {
+  if ( grp_fd ) {
+    fclose ( grp_fd );
+  }
+  grp_fd = fopen( _PATH_GROUP, "r" );
+}
+
+__weak_symbol void endgrent( void ) {
+  if ( grp_fd ) {
+    fclose( grp_fd );
+    grp_fd = NULL;
+  }
+}
+
+__weak_symbol struct group* getgrgid( gid_t gid ) {
+  struct group* g = NULL;
+  // initialize
+  setgrent();
+  // loop through entries
+  while ( ( g = getgrent() ) ) {
+    if ( g->gr_gid == gid ) {
+      break;
+    }
+  }
+  // finish
+  endgrent();
+  // return possible found group
+  return g;
+}
+
+__weak_symbol struct group* getgrnam( const char* name ) {
+  struct group* g = NULL;
+  // initialize
+  setgrent();
+  // loop through entries
+  while ( ( g = getgrent() ) ) {
+    if (
+      strlen( g->gr_name ) == strlen( name )
+      && 0 == strcmp( g->gr_name, name )
+    ) {
+      break;
+    }
+  }
+  // finish
+  endgrent();
+  // return possible found group
+  return g;
+}
+
+int getgrnam_r ( const char* name, struct group* grp, char* buffer, size_t size, struct group** result ) {
+  return ENOSYS;
+}
+
+int getgrgid_r ( gid_t gid, struct group* grp, char* buffer, size_t size, struct group** result ) {
+  return ENOSYS;
+}
