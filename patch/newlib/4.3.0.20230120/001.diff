index 000000000..d328bc81f
--- /dev/null
+++ libgloss/arm/bolthur-system-call0.S
@@ -0,0 +1,83 @@
+
+/**
+ * Bolthur system call numbers for the ARM processor.
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "bolthur-system-call.h"
+
+#if __thumb__
+# define FUNC(name) .type name, %function; .thumb_func; name:
+# define SET .thumb_set
+#else
+# define FUNC(name) .type name, %function; name:
+# define SET .set
+#endif
+
+#define GLOBAL(name) .global name; FUNC(name)
+#define SIZE(name) .size name, .-name
+
+#define SYSTEM_CALL(name) \
+	GLOBAL(_ ## name); \
+	svc #SYSTEM_CALL_ ## name; \
+	b _set_errno; \
+	SIZE(_ ## name)
+
+#define SYSTEM_CALL7(name) \
+	GLOBAL(_ ## name); \
+	push { r4 - r6 }; \
+	ldr r4, [ sp, #12 ]; \
+	ldr r5, [ sp, #16 ]; \
+	ldr r6, [ sp, #20 ]; \
+	svc #SYSTEM_CALL_ ## name; \
+	pop { r4 - r6 }; \
+	b _set_errno; \
+	SIZE(_ ## name)
+
+// system calls
+SYSTEM_CALL( syscall_process_exit )
+SYSTEM_CALL( syscall_process_id )
+SYSTEM_CALL( syscall_process_parent_id )
+SYSTEM_CALL( syscall_process_fork )
+SYSTEM_CALL( syscall_process_replace )
