+#include <assert.h>
+#include <sys/bolthur.h>
+
+/**
+ * @brief Construct a new assert func object
+ *
+ * @param file
+ * @param line
+ * @param func
+ * @param failedexpr
+ */
+void __assert_func(
+  const char *file,
+  int line,
+  const char *func,
+  const char *failedexpr
+) {
+  EARLY_STARTUP_PRINT(
+    "assertion \"%s\" failed: file \"%s\", line %d%s%s\n",
+    failedexpr, file, line,
+    func ? ", function: " : "", func ? func : ""
+  )
+  abort();
+  /* NOTREACHED */
+}
