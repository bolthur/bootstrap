diff --git newlib/libc/sys/bolthur/mman/mman-lock.c newlib/libc/sys/bolthur/mman/mman-lock.c
new file mode 100644
index 000000000..d3817a6ea
--- /dev/null
+++ newlib/libc/sys/bolthur/mman/mman-lock.c
@@ -0,0 +1,57 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <sys/mman.h>
+#include <sys/cdefs.h>
+
+/**
+ * @brief lock a range of process address space
+ *
+ * @param addr
+ * @param len
+ * @return int
+ */
+__weak_symbol int mlock( const void* addr, size_t len ) {
+  errno = ENOSYS;
+  return -1;
+}
+
+/**
