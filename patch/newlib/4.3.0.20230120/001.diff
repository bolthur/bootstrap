diff --git newlib/libc/sys/bolthur/syscall/syscall-fork.c newlib/libc/sys/bolthur/syscall/syscall-fork.c
new file mode 100644
index 000000000..687e7edaa
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-fork.c
@@ -0,0 +1,100 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @brief Process fork
+ *
+ * @return new created process id
+ */
+__weak_symbol pid_t _fork( void ) {
+  // fork process itself
+  pid_t id = _syscall_process_fork();
+  if ( errno ) {
+    return id;
+  }
+  // send fork request to vfs
+  if ( 0 == id && VFS_DAEMON_ID != getpid() ) {
+    // allocate request and response
+    vfs_fork_request_t* request = malloc( sizeof( vfs_fork_request_t ) );
+    if ( ! request ) {
+      errno = ENOMEM;
+      return -1;
+    }
+    vfs_fork_response_t* response = malloc( sizeof( vfs_fork_response_t ) );
+    if ( ! response ) {
+      free( request );
+      errno = ENOMEM;
+      return -1;
+    }
+    // allocate message structures
+    memset( request, 0, sizeof( vfs_fork_request_t ) );
+    memset( response, 0, sizeof( vfs_fork_response_t ) );
+    // prepare message structure
+    request->parent = getppid();
+    // raise rpc and wait for return
+    size_t response_id = bolthur_rpc_raise(
+      RPC_VFS_FORK,
+      VFS_DAEMON_ID,
+      request,
+      sizeof( vfs_fork_request_t ),
+      NULL,
+      RPC_VFS_FORK,
+      request,
+      sizeof( vfs_fork_request_t ),
+      0,
+      0,
+      NULL
+    );
+    // handle error
+    if ( 0 == response_id ) {
+      free( request );
+      free( response );
+      return -1;
+    }
+    // get response
+    _syscall_rpc_get_data(
+      response,
+      sizeof( vfs_fork_response_t ),
+      response_id,
+      false
+    );
+    // handle error
+    if ( errno ) {
+      free( request );
+      free( response );
+      return -1;
+    }
+    // special error handling
+    if ( response->status < 0 ) {
+      errno = -response->status;
+      free( request );
+      free( response );
+      return -1;
+    }
+    free( request );
+    free( response );
+  }
+  // return id
+  return id;
+}
+
+/**
+ * @brief vfork just calls fork as it's marked as obsolescent in posix
+ *
+ * @return new created process id
+ */
+__weak_symbol pid_t vfork( void ) {
+  return fork();
+}
diff --git newlib/libc/sys/bolthur/syscall/syscall-fstat.c newlib/libc/sys/bolthur/syscall/syscall-fstat.c
new file mode 100644
index 000000000..dba04ca22
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-fstat.c
@@ -0,0 +1,89 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+/**
+ * @fn int _fstat(int, struct stat*)
+ * @brief fstat implementation
+ *
+ * @param file
+ * @param st
+ * @return
+ *
+ * @todo remove weak symbol once implementation is finished
+ */
+__weak_symbol int _fstat( int file, struct stat* st ) {
+  // variables
+  vfs_stat_request_t* request = malloc( sizeof( vfs_stat_request_t ) );
+  if ( ! request ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  vfs_stat_response_t* response = malloc( sizeof( vfs_stat_response_t ) );
+  if ( ! response ) {
+    free( request );
+    errno = ENOMEM;
+    return -1;
+  }
+  // clear message structures
+  memset( request, 0, sizeof( vfs_stat_request_t ) );
+  memset( response, 0, sizeof( vfs_stat_response_t ) );
+  // copy stuff to message
+  request->handle = file;
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_STAT,
+    VFS_DAEMON_ID,
+    request,
+    sizeof( vfs_stat_request_t ),
+    NULL,
+    RPC_VFS_STAT,
+    request,
+    sizeof( vfs_stat_request_t ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    free( request );
+    free( response );
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data(
+    response,
+    sizeof( vfs_stat_response_t ),
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    free( request );
+    free( response );
+    return -1;
+  }
+  // handle failure
+  if ( ! response->success ) {
+    free( request );
+    free( response );
+    errno = EIO;
+    return -1;
+  }
+  // copy over stat content
+  memcpy( st, &response->info, sizeof( struct stat ) );
+  return 0;
+}
