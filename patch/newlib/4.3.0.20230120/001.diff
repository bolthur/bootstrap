diff --git newlib/libc/sys/bolthur/io.c newlib/libc/sys/bolthur/io.c
new file mode 100644
index 000000000..5a638f1d8
--- /dev/null
+++ newlib/libc/sys/bolthur/io.c
@@ -0,0 +1,140 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdlib.h>
+#include <stdarg.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn int ioctl(int, uint64_t, ...)
+ * @brief ioctl implementation
+ *
+ * @param file file descriptor
+ * @param request request information ( command and data size combined )
+ * @param ... optional third parameter for data
+ * @return
+ *
+ * @todo add reentrance safety
+ */
+__weak_symbol int ioctl( int file, uint64_t request, ... ) {
+  // extract size and request from request ( 16 bit each )
+  uint32_t command = IOCTL_REQUEST_GET_COMMAND( request );
+  uint32_t data_size = IOCTL_REQUEST_GET_SIZE( request );
+  uint32_t type = IOCTL_REQUEST_GET_TYPE( request );
+  // extract possible data parameter
+  va_list list;
+  va_start( list, request );
+  void* data = ( void* )va_arg( list, void* );
+  va_end( list );
+  // handle invalid data
+  if ( ! data && data_size ) {
+    errno = EINVAL;
+    return -1;
+  }
+  // calculate rpc request size
+  size_t rpc_request_size = sizeof( vfs_ioctl_perform_request_t );
+  // add data to ioctl if existing
+  if ( data && data_size && IOCTL_NONE != type ) {
+    rpc_request_size += data_size * sizeof( char );
+  }
+  // allocate rpc structures
+  vfs_ioctl_perform_request_t* rpc_request = malloc( rpc_request_size );
+  if ( ! rpc_request ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  // clear rpc structures
+  memset( rpc_request, 0, rpc_request_size );
+  // populate structure
+  rpc_request->handle = file;
+  rpc_request->command = command;
+  rpc_request->type = type;
+  // push data if set / passed
+  if ( data && data_size && IOCTL_NONE != type ) {
+    memcpy( rpc_request->container, data, data_size * sizeof( char ) );
+  }
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_IOCTL,
+    VFS_DAEMON_ID,
+    rpc_request,
+    rpc_request_size,
+    NULL,
+    RPC_VFS_IOCTL,
+    rpc_request,
+    rpc_request_size,
+    0,
+    0,
+    NULL
+  );
+  if ( errno ) {
+    // free request data
+    free( rpc_request );
+    return -1;
+  }
+  // free request data
+  free( rpc_request );
+  // handle error
+  if ( 0 == response_id ) {
+    return -1;
+  }
+  // get size for allocation
+  size_t rpc_response_size = _syscall_rpc_get_data_size( response_id );
+  if ( errno ) {
+    return -1;
+  }
+  vfs_ioctl_perform_response_t* rpc_response = malloc( rpc_response_size );
+  if ( ! rpc_response ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  // clear rpc structures
+  memset( rpc_response, 0, rpc_response_size );
+  // get response
+  _syscall_rpc_get_data(
+    rpc_response,
+    rpc_response_size,
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    free( rpc_response );
+    return -1;
+  }
+  // save response status before free
+  int status = rpc_response->status;
+  if ( 0 > status ) {
+    free( rpc_response );
+    errno = -status;
+    return -1;
+  }
+  uint32_t response_data_size = rpc_response_size - sizeof( vfs_ioctl_perform_response_t );
+  // copy response data if set
+  if ( data && data_size && IOCTL_NONE != type ) {
+    // handle no data with clear
+    if ( 0 == response_data_size ) {
+      memset( data, 0, data_size );
+    // handle data size is to small
+    } else if ( data_size < response_data_size ) {
+      free( rpc_response );
+      errno = ENOMEM;
+      return -1;
+    // copy over content
+    } else {
+      memcpy( data, rpc_response->container, response_data_size );
+    }
+  }
+  // free stuff and return
+  free( rpc_response );
+  return status;
+}
diff --git newlib/libc/sys/bolthur/machine/arm/dl-handle.h newlib/libc/sys/bolthur/machine/arm/dl-handle.h
new file mode 100644
index 000000000..a5081f4cf
--- /dev/null
+++ newlib/libc/sys/bolthur/machine/arm/dl-handle.h
@@ -0,0 +1,99 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <elf.h>
+
+#if !defined( _MACHINE_ARM_DL_HANDLE_H )
+#define _MACHINE_ARM_DL_HANDLE_H
+
+#define ELF_MACHINE_RUNTIME_TRAMPOLINE asm("\n\
+  .text\n\
+  .global dl_resolve_stub\n\
+  .extern dl_resolve_lazy\n\
+  dl_resolve_stub: \n\
+  // ip contains &GOT[n+3] (pointer to function) \n\
+  // lr points to &GOT[2] \n\
+  // push argument registers to stack \n\
+  stmdb sp!, {r0-r3} \n\
+  // extract handle pointer from stack \n\
+  ldr r0, [ lr, #-4 ] \n\
+  // extract symbol \n\
+  sub r1, ip, lr \n\
+  sub r1, #4 \n\
+  add r1, r1 \n\
+  // call to resolve lazy \n\
+  bl dl_resolve_lazy \n\
+  // save return \n\
+  mov r12, r0 \n\
+  // restore arguments for original function to call \n\
+  ldmia sp!, {r0, r1, r2, r3, lr} \n\
+  // branch to looked up function \n\
+  mov pc, r12 \n\
+");
+
+__BEGIN_DECLS
+
+// image handle
+struct dl_image_handle {
+  // file header
+  Elf32_Ehdr header;
+
+  // pointer to next / previous entry
+  dl_image_handle_t* next;
+  dl_image_handle_t* previous;
+
+  // file information
+  int descriptor;
+  int open_mode;
+  int link_count;
+  char* filename;
+  bool relocated;
+
+  // init and fini function reference
+  init_callback_t init;
+  init_callback_t fini;
+  init_callback_t init_array;
+  size_t init_array_size;
+  init_callback_t fini_array;
+  size_t fini_array_size;
+  // more general informations for linking / loading
+  char* memory_start;
+  size_t memory_size;
+
+  // necessary elf section attributes
+  Elf32_Dyn* dyn;
+  Elf32_Phdr* phdr;
+  char* strtab;
+  size_t strsz;
+  Elf32_Sym* symtab;
+  struct {
+    uint32_t* table;
+    dl_image_hash_style_t style;
+    uint32_t nbucket;
+    uint32_t nchain;
+    hash_callback_t build;
+  } hash;
+  void* jmprel;
+  uint32_t pltrel;
+  uint32_t pltrelsz;
+  void* rel;
+  uint32_t relsz;
+  uint32_t relent;
+  void* rela;
+  uint32_t relasz;
+  uint32_t relaent;
+  void** pltgot;
+};
+
+__END_DECLS
+
+#endif
diff --git newlib/libc/sys/bolthur/machine/arm/dl-lookup.c newlib/libc/sys/bolthur/machine/arm/dl-lookup.c
new file mode 100644
index 000000000..dabbfebe3
--- /dev/null
+++ newlib/libc/sys/bolthur/machine/arm/dl-lookup.c
@@ -0,0 +1,67 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "../../dl/dl-type.h"
+
+/**
+ * @fn void dl_lookup_symbol*(dl_image_handle_t*, const char*)
+ * @brief Helper to lookup a symbol
+ *
+ * @param handle
+ * @param name
+ */
+__hidden void* dl_lookup_symbol( dl_image_handle_t* handle, const char* name ) {
+  void* found_symbol = NULL;
+  dl_image_handle_t* current = handle;
+  if ( ! handle ) {
+    current = root_object_handle;
+  }
+  // loop through handles
+  while ( current && ! found_symbol ) {
+    // get hash from name
+    uint32_t hash = current->hash.build( name );
+    uint32_t nbucket = current->hash.nbucket;
+    uint32_t nchain = current->hash.nchain;
+    uint32_t* buckets = &current->hash.table[ 2 ];
+    uint32_t* chain = &current->hash.table[ 2 + nbucket ];
+    Elf32_Sym* sym;
+    const char* sym_name;
+    uint32_t index = buckets[ hash % nbucket ];
+    while ( index != STN_UNDEF) {
+      if ( index > nchain) {
+        // FIXME: SET ERROR AND RETURN?
+        break;
+      }
+      // get symbol
+      sym = &current->symtab[ index ];
+      if ( sym->st_name > current->strsz ) {
+        // FIXME: SET ERROR AND RETURN?
+        break;
+      }
+      sym_name = current->strtab + sym->st_name;
+      if ( 0 == strcmp( sym_name, name ) ) {
+        if ( sym->st_shndx != SHN_UNDEF ) {
+          found_symbol = ( void* )sym->st_value;
+          if ( current->relocated ) {
+            found_symbol = ( void* )( current->memory_start + ( uint32_t )found_symbol );
+          }
+          break;
+        } else {
+          // undefined symbol
+          break;
+        }
+      }
+      index = chain[ index ];
+    }
+    // next handle
+    current = current->next;
+  }
+  // return found symbol
+  return found_symbol;
+}
diff --git newlib/libc/sys/bolthur/machine/arm/elf.h newlib/libc/sys/bolthur/machine/arm/elf.h
new file mode 100644
index 000000000..c152bd8e2
--- /dev/null
+++ newlib/libc/sys/bolthur/machine/arm/elf.h
@@ -0,0 +1,177 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#if defined( _COMPILING_NEWLIB ) || defined( _LD_BOLTHUR_SO )
+
+#include <stdbool.h>
+#include <elf.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+
+#if !defined( _MACHINE_ARM_ELF_H )
+#define _MACHINE_ARM_ELF_H
+
+/**
+ * @fn bool elf_read_header(int, Elf32_Ehdr*)
+ * @brief Helper to read elf header
+ *
+ * @param fd
+ * @param header
+ * @return
+ */
+static bool elf_read_header( int fd, Elf32_Ehdr* header ) {
+  if ( ! header || 0 != lseek( fd, ( off_t )0, SEEK_SET ) ) {
+    return false;
+  }
+  return sizeof( *header ) == read( fd, ( void* )header, sizeof( *header ) );
+}
+
+/**
+ * @fn bool elf_read_program_header(int, uint32_t, Elf32_Ehdr*, Elf32_Phdr*)
+ * @brief Helper to read program header
+ *
+ * @param fd
+ * @param idx
+ * @param header
+ * @param program_header
+ * @return
+ */
+static bool elf_read_program_header(
+  int fd,
+  uint32_t idx,
+  Elf32_Ehdr* header,
+  Elf32_Phdr* program_header
+) {
+  if (
+    ! header
+    || ! program_header
+    || 0 != lseek( fd, ( off_t )0, SEEK_SET )
+    || idx > header->e_phnum
+  ) {
+    return false;
+  }
+  // set file pointer to offset
+  if ( -1 == lseek( fd, ( off_t )( header->e_phoff + header->e_phentsize * idx ), SEEK_SET ) ) {
+    return false;
+  }
+  // try to read
+  return sizeof( *program_header ) == read( fd, ( void* )program_header, sizeof( *program_header ) );
+}
+
+/**
+ * @fn bool elf_validate_header(const char*)
+ * @brief Validate elf header of file
+ *
+ * @param name
+ * @return
+ */
+static bool elf_validate_header( const char* name ) {
+  // try to open target
+  int fd = open( name, O_RDONLY );
+  if ( -1 == fd ) {
+    return false;
+  }
+  Elf32_Ehdr header;
+  if ( ! elf_read_header( fd, &header ) ) {
+    close( fd );
+    return false;
+  }
+  // check magic
+  if (
+    ELFMAG0 != header.e_ident[ EI_MAG0 ]
+    || ELFMAG1 != header.e_ident[ EI_MAG1 ]
+    || ELFMAG2 != header.e_ident[ EI_MAG2 ]
+    || ELFMAG3 != header.e_ident[ EI_MAG3 ]
+  ) {
+    close( fd );
+    return false;
+  }
+  // check architecture
+  if ( ELFCLASS32 != header.e_ident[ EI_CLASS ] ) {
+    close( fd );
+    return false;
+  }
+  if ( EM_ARM != header.e_machine ) {
+    close( fd );
+    return false;
+  }
+  // further header checks
+  if ( 0 == header.e_phentsize ) {
+    close( fd );
+    return false;
+  }
+  // ensure section header existence
+  if ( 0 == header.e_shentsize ) {
+    close( fd );
+    return false;
+  }
+  close( fd );
+  return true;
+}
+
+/**
+ * @fn char elf_read_optional_interpreter*(const char*)
+ * @brief Helper to read optional interpreter string
+ *
+ * @param name
+ * @return
+ */
+static char* elf_read_optional_interpreter( const char* name ) {
+  // try to open target
+  int fd = open( name, O_RDONLY );
+  if ( -1 == fd ) {
+    return NULL;
+  }
+  // local variables for header and program header
+  Elf32_Ehdr header;
+  Elf32_Phdr program_header;
+  // read header
+  if ( ! elf_read_header( fd, &header ) ) {
+    close( fd );
+    return NULL;
+  }
+  // Check for interpreter section
+  char* interp = NULL;
+  for ( size_t idx = 0; idx < header.e_phnum; idx++ ) {
+    // read section
+    if ( ! elf_read_program_header( fd, idx, &header, &program_header ) ) {
+      close( fd );
+      return NULL;
+    }
+    // skip non interpreter sections
+    if ( PT_INTERP != program_header.p_type ) {
+      continue;
+    }
+    // set flag
+    size_t sz = program_header.p_filesz;
+    interp = ( char* )malloc( sz * sizeof( char ) );
+    if ( ! interp ) {
+      close( fd );
+      return NULL;
+    }
+    // reset back to beginning
+    if ( ( off_t )program_header.p_offset != lseek( fd, ( off_t )program_header.p_offset, SEEK_SET ) ) {
+      free( interp );
+      close( fd );
+      return NULL;
+    }
+    if ( ( ssize_t )sz != read( fd, interp, sizeof( uint8_t ) * sz ) ) {
+      free( interp );
+      close( fd );
+      return NULL;
+    }
+    break;
+  }
+  close( fd );
+  return interp;
+}
+
+#endif
+
+#endif
