+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn int _isatty(int)
+ * @brief isatty system call implementation
+ *
+ * @param file file descriptor
+ * @return 1 = tty, 0 = no tty
+ *
+ * @todo Add further checks after check for character device to ensure tty
+ */
+__weak_symbol int _isatty( int file ) {
+  struct stat buffer;
+  // get file stats
+  if ( 0 > fstat( file, &buffer ) ) {
+    errno = EBADF;
+    return 0;
+  }
+  // check for character device
+  if ( ! S_ISCHR( buffer.st_mode ) ) {
+    errno = ENOTTY;
+    return 0;
+  }
+  // return success
+  return 1;
+}
