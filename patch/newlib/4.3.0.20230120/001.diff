+__weak_symbol int getdents( int fd, void* dirp, int count ) {
+  // allocate request for notification
+  vfs_getdents_request_t* request = malloc( sizeof( *request ) );
+  // handle error
+  if ( ! request ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  // clear request
+  memset( request, 0, sizeof( *request ) );
+  // populate request
+  request->fd = fd;
+  request->count = count;
+  // raise rpc without wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_GETDENTS,
+    VFS_DAEMON_ID,
+    request,
+    sizeof( *request ),
+    NULL,
+    RPC_VFS_GETDENTS,
+    request,
+    sizeof( *request ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    free( request );
+    errno = EIO;
+    return -1;
+  }
+  // free request
+  free( request );
+  // get data size
+  size_t size = _syscall_rpc_get_data_size( response_id );
+  if ( errno ) {
+    return -1;
+  }
+  // allocate dummy response for notification
+  vfs_getdents_response_t* response = malloc( size );
+  // handle error
+  if ( ! response ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data( response, size, response_id, false );
+  // handle error
+  if ( errno ) {
+    free( response );
+    return -1;
+  }
+  // handle error
+  if ( 0 > response->result ) {
+    errno = -response->result;
+    free( response );
+    return -1;
+  }
+  // copy over data
+  memcpy( dirp, response->buffer, count );
+  int len = response->len;
+  // free up request again
+  free( response );
+  // return success
+  return len;
+}
+
+__weak_symbol int chdir( const char *path ) {
+  errno = ENOSYS;
+  return -1;
+}
