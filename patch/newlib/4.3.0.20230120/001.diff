+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn off_t _lseek(int, off_t, int)
+ * @brief _lseek system call implementation
+ *
+ * @param file
+ * @param pos
+ * @param dir
+ * @return
+ */
+__weak_symbol off_t _lseek( int file, off_t pos, int dir ) {
+  // variables
+  vfs_seek_request_t* request = malloc( sizeof( vfs_seek_request_t ) );
+  if ( ! request ) {
+    errno = ENOMEM;
+    return -1;
+  }
+  vfs_seek_response_t* response = malloc( sizeof( vfs_seek_response_t ) );
+  if ( ! response ) {
+    free( request );
+    errno = ENOMEM;
+    return -1;
+  }
+  // allocate message structures
+  memset( request, 0, sizeof( vfs_seek_request_t ) );
+  memset( response, 0, sizeof( vfs_seek_response_t ) );
+  // prepare message structure
+  request->handle = file;
+  request->offset = pos;
+  request->whence = dir;
+  // raise rpc and wait for return
+  size_t response_id = bolthur_rpc_raise(
+    RPC_VFS_SEEK,
+    VFS_DAEMON_ID,
+    request,
+    sizeof( vfs_seek_request_t ),
+    NULL,
+    RPC_VFS_SEEK,
+    request,
+    sizeof( vfs_seek_request_t ),
+    0,
+    0,
+    NULL
+  );
+  // handle error
+  if ( 0 == response_id ) {
+    free( request );
+    free( response );
+    return -1;
+  }
+  // get response
+  _syscall_rpc_get_data(
+    response,
+    sizeof( vfs_seek_response_t ),
+    response_id,
+    false
+  );
+  // handle error
+  if ( errno ) {
+    free( request );
+    free( response );
+    return -1;
+  }
+  // special error handling
+  if ( response->position < 0 ) {
+    errno = -response->position;
+    free( request );
+    free( response );
+    return -1;
+  }
+  off_t status = response->position;
+  free( request );
+  free( response );
+  // return status
+  return status;
+}
