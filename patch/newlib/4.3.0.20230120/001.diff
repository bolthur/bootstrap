+++ newlib/libc/sys/bolthur/dl/dl-close.c
@@ -0,0 +1,75 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "dl-type.h"
+#include "dl-handle.h"
+
+/**
+ * @fn int dl_close(dl_image_handle_t*)
+ * @brief Internal close function with correct type
+ *
+ * @param handle
+ * @return
+ *
+ * @todo add support for fini array
+ */
+static int _dlclose( dl_image_handle_t* handle ) {
+  // decrease link count
+  handle->link_count -= 1;
+  // skip if still referenced somewhere
+  if ( 0 < handle->link_count ) {
+    return 0;
+  }
+  // execute fini
+  if ( handle->fini ) {
+    handle->fini();
+  }
+
+  // decrement link count of libraries needed by this one
+  for (
+    Elf32_Dyn* current = handle->dyn;
+    current->d_tag != DT_NULL;
+    current++
+  ) {
+    // skip everything except DT_NEEDED
+    if ( DT_NEEDED != current->d_tag ) {
+      continue;
+    }
+    // get library name
+    char* name = handle->strtab + current->d_un.d_val;
+    // try to close library ( maybe a dependency )
+    _dlclose( dl_find_loaded_library( name ) );
+  }
+
+  // unmap memory
+  if ( -1 == munmap( handle->memory_start, handle->memory_size ) ) {
+    return -1;
+  }
+  // remove handle from list
+  dl_free_handle( handle );
+  // return success
+  return 0;
+}
+
+/**
+ * @fn int dlclose(void*)
+ * @brief Close opened handle again
+ *
+ * @param handle
+ * @return
+ */
+__weak_symbol int dlclose( void* handle ) {
+  // set error location
+  dl_error_location = "dlclose";
+  // skip invalid handles
+  if ( ! handle ) {
+    return 0;
+  }
+  return _dlclose( handle );
+}
diff --git newlib/libc/sys/bolthur/dl/dl-error.c newlib/libc/sys/bolthur/dl/dl-error.c
new file mode 100644
index 000000000..09926068b
--- /dev/null
+++ newlib/libc/sys/bolthur/dl/dl-error.c
@@ -0,0 +1,123 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "dl-type.h"
+
+#define ERROR_BUFFER_SIZE 1024
+
+// FIXME: PUSH VARIABLES TO REENT STRUCTURE
+uint32_t dl_error;
+const char* dl_error_location;
+const char* dl_error_data;
+char* dlerror_buffer;
+
+static dl_message_entry_t dl_error_message[] = {
+  { "Could not open library: " },
+  { "Could not find library: " },
+  { "Error while allocating memory" },
+  { "Error while reading header" },
+  { "Wrong elf magic / not an elf object" },
+  { "Wrong elf byte class" },
+  { "Wrong elf machine" },
+  { "No program header found" },
+  { "No section header found" },
+  { "Not supported behaviour" },
+  { "Unknown error" },
+};
+
+/**
+ * @fn void _dlerror_setup(void)
+ * @brief dlerror setup stuff
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void __attribute__(( constructor )) _dlerror_setup( void ) {
+  // FIXME: Allocate space for error messages and push in
+  // allocate dlerror buffer
+  dlerror_buffer = malloc( sizeof( char ) * ERROR_BUFFER_SIZE );
+  if ( ! dlerror_buffer ) {
+    exit( 1 );
+  }
+}
+
+/**
+ * @fn char dlerror*(void)
+ * @brief Method to get the possible set error code of dynamic linking
+ *
+ * @return
+ */
+__weak_symbol char* dlerror( void ) {
+  // set total length to length - 1 to leave space for 0 termination
+  size_t total_length = ERROR_BUFFER_SIZE - 1;
+  // clear buffer
+  memset( dlerror_buffer, 0, sizeof( char ) * ERROR_BUFFER_SIZE );
+  // handle no error
+  if ( 0 == dl_error ) {
+    strncpy( dlerror_buffer, "no error", total_length );
+    // reset globals
+    dl_error_location = 0;
+    dl_error_data = "";
+    dl_error = 0;
+    // return buffer
+    return dlerror_buffer;
+  }
+  // determine entry count
+  size_t error_count = sizeof( dl_error_message ) / sizeof( dl_message_entry_t );
+  // handle invalid error code
+  if ( dl_error >= error_count ) {
+    // copy over last error message
+    strncpy(
+      dlerror_buffer,
+      dl_error_message[ error_count - 1 ].message,
+      total_length
+    );
+    // reset globals
+    dl_error_location = 0;
+    dl_error_data = "";
+    dl_error = 0;
+    // return buffer
+    return dlerror_buffer;
+  }
+  // valid error code fill buffer
+  char *buffer_pos = dlerror_buffer;
+  size_t length;
+  // check if location is set
+  if ( dl_error_location ) {
+    // determine length of error location
+    length = strlen( dl_error_location );
+    // push location string to buffer
+    strncpy( buffer_pos, dl_error_location, total_length );
+    // decrement total length and increment buffer position
+    total_length -= length;
+    buffer_pos += length;
+    // add colon separator
+    strncpy( buffer_pos, ": ", total_length );
+    // decrement total length and increment buffer position
+    total_length -= 2;
+    buffer_pos += 2;
+  }
+  // get length of message
+  length = strlen( dl_error_message[ dl_error - 1 ].message );
+  // push message string to buffer
+  strncpy( buffer_pos, dl_error_message[ dl_error - 1 ].message, total_length );
+  // decrement total length and increment buffer position
+  total_length -= length;
+  buffer_pos += length;
+  // push error data if set
+  if ( dl_error_data ) {
+    strncpy( buffer_pos, dl_error_data, total_length );
+  }
+  // reset globals
+  dl_error_location = 0;
+  dl_error_data = "";
+  dl_error = 0;
+  // return buffer
+  return dlerror_buffer;
+}
