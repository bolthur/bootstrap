+
+#include "rpc-rpc.h"
+
+/**
+ * @fn rpc_handler_t bolthur_rpc_unbind(size_t)
+ * @brief get bound rpc handler by type
+ *
+ * @param num rpc type to get handler for
+ * @return NULL if not found or registered handler
+ */
+rpc_handler_t bolthur_rpc_get( size_t num ) {
+  return _bolthur_rpc_get_r( _REENT, num );
+}
+
+/**
+ * @fn rpc_handler_t _bolthur_rpc_get_r(struct _reent*, size_t)
+ * @brief reentrant rpc bind handler
+ *
+ * @param rptr
+ * @param num
+ *
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol rpc_handler_t _bolthur_rpc_get_r(
+  struct _reent* r,
+  size_t num
+) {
+  // handle bind interrupt
+  if ( num <= RPC_INTERRUPT_END ) {
+    return _bolthur_handler_interrupt[ num ];
+  }
+  // signals not handled here
+  if ( num >= RPC_SIGNAL_START && num <= RPC_SIGNAL_END ) {
+    r->_errno = ENOSYS;
+    return NULL;
+  }
+  // handle possible custom handler
+  for ( size_t idx = 0; idx < _bolthur_handler_custom_size; idx++ ) {
+    // return handler if num is equal
+    if ( num == _bolthur_handler_custom[ idx ].num ) {
+      return _bolthur_handler_custom[ idx ].handler;
+    }
+  }
+  // return null
+  return NULL;
+}
