diff --git newlib/libc/sys/bolthur/syscall/syscall-write.c newlib/libc/sys/bolthur/syscall/syscall-write.c
new file mode 100644
index 000000000..8a3474a3f
--- /dev/null
+++ newlib/libc/sys/bolthur/syscall/syscall-write.c
@@ -0,0 +1,124 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <assert.h>
+#include <string.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @brief Write implementation
+ *
+ * @param file file to write to
+ * @param ptr data pointer
+ * @param len amount to write
+ * @return ssize_t
+ *
+ * @todo add logic
+ */
+__weak_symbol ssize_t _write( int file, const void* ptr, size_t len ) {
+  // check file stat
+  struct stat st;
+  int stat_result = fstat( file, &st );
+  // handle invalid
+  if ( -1 == stat_result ) {
+    errno = EACCES;
+    return -1;
+  }
+
+  // some additional variables
+  size_t written_amount = 0;
+  char* buf = ( char* )ptr;
+  // allocate message structures
+  vfs_write_request_t* request = malloc( sizeof( vfs_write_request_t ) );
+  if ( ! request ) {
+    errno = ENOBUFS;
+    return -1;
+  }
+  vfs_write_response_t* response = malloc( sizeof( vfs_write_response_t ) );
+  if ( ! response ) {
+    free( request );
+    errno = ENOBUFS;
+    return -1;
+  }
+  // write by sending messages
+  while( written_amount < len ) {
+    // set amount to read
+    size_t amount = len - written_amount;
+    if ( amount > MAX_WRITE_LEN ) {
+      amount = MAX_WRITE_LEN;
+    }
+    // clear message structures
+    memset( request, 0, sizeof( vfs_write_request_t ) );
+    memset( response, 0, sizeof( vfs_write_response_t ) );
+    // prepare message structure
+    request->len = amount;
+    request->handle = file;
+    request->offset = ( off_t )written_amount;
+    memcpy( request->data, buf + written_amount, amount );
+    // raise rpc and wait for return
+    size_t response_id = bolthur_rpc_raise(
+      RPC_VFS_WRITE,
+      VFS_DAEMON_ID,
+      request,
+      sizeof( vfs_write_request_t ),
+      NULL,
+      RPC_VFS_WRITE,
+      request,
+      sizeof( vfs_write_request_t ),
+      0,
+      0,
+      NULL
+    );
+    // handle error
+    if ( 0 == response_id ) {
+      free( request );
+      free( response );
+      return -1;
+    }
+    // get response
+    _syscall_rpc_get_data(
+      response,
+      sizeof( vfs_write_response_t ),
+      response_id,
+      false
+    );
+    // handle error
+    if ( errno ) {
+      free( request );
+      free( response );
+      return -1;
+    }
+    // special error handling
+    if ( response->len < 0 ) {
+      errno = -response->len;
+      free( request );
+      free( response );
+      return -1;
+    }
+    // handle 0
+    if ( response->len == 0 ) {
+      break;
+    }
+    // increase by amount read
+    written_amount += amount;
+  }
+  free( request );
+  free( response );
+  // return read amount
+  return ( ssize_t )written_amount;
+}
