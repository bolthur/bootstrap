diff --git newlib/libc/sys/bolthur/include/sys/ioctl.h newlib/libc/sys/bolthur/include/sys/ioctl.h
new file mode 100644
index 000000000..9b5a17148
--- /dev/null
+++ newlib/libc/sys/bolthur/include/sys/ioctl.h
@@ -0,0 +1,41 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <unistd.h>
+#include <stdint.h>
+#include <inttypes.h>
+
+#ifndef _IOCTL_H
+#define _IOCTL_H
+
+#define IOCTL_NONE 0
+#define IOCTL_RDONLY 1
+#define IOCTL_WRONLY 2
+#define IOCTL_RDWR 3
+
+#define IOCTL_BUILD_REQUEST(command,size,type) \
+  ( uint64_t )( \
+    ( uint64_t )( command & 0xFFFFFFFF ) \
+    | ( uint64_t )( size & 0x3FFFFFFF ) << 32 \
+    | ( uint64_t )( type & 0x3 ) << 62 \
+  )
+
+#define IOCTL_REQUEST_GET_COMMAND(request) ( uint32_t )request
+#define IOCTL_REQUEST_GET_SIZE(request) \
+  ( uint32_t )( ( uint64_t )request >> 32 & 0x3FFFFFFF )
+#define IOCTL_REQUEST_GET_TYPE(request) \
+  ( uint32_t )( ( uint64_t )request >> 62 )
+
+__BEGIN_DECLS
+
+int ioctl( int, uint64_t, ... );
+
+__END_DECLS
+
+#endif
