+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <errno.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn void watch_path_notify(const char*, pid_t)
+ * @brief Notify a process about a change in path
+ *
+ * @param path
+ * @param pid
+
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void watch_path_notify( const char* path, pid_t pid ) {
+  // allocate request for notification
+  vfs_watch_notify_request_t* request = malloc( sizeof( *request ) );
+  // handle error
+  if ( ! request ) {
+    errno = ENOMEM;
+    return;
+  }
+  // clear request
+  memset( request, 0, sizeof( *request ) );
+  // populate request
+  request->handler = pid;
+  strncpy(request->target, path, PATH_MAX - 1);
+  // raise rpc without wait for return
+  bolthur_rpc_raise_generic(
+    RPC_VFS_WATCH_NOTIFY,
+    VFS_DAEMON_ID,
+    request,
+    sizeof( *request ),
+    NULL,
+    RPC_VFS_WATCH_NOTIFY,
+    request,
+    sizeof( *request ),
+    0,
+    0,
+    NULL,
+    true
+  );
+  // free request again
+  free( request );
+}
\ No newline at end of file
