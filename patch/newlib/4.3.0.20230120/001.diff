diff --git libgloss/arm/bolthur-crt0-static.c libgloss/arm/bolthur-crt0-static.c
new file mode 100644
index 000000000..21f57c814
--- /dev/null
+++ libgloss/arm/bolthur-crt0-static.c
@@ -0,0 +1,97 @@
+
+/**
+ * Bolthur system startup for the ARM processor.
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+/**
+ * Bolthur startup code for arm processor
+ */
+#include <stdlib.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <stdnoreturn.h>
+#include <errno.h>
+#include <sys/bolthur.h>
+#include "arm.h"
+#include "newlib.h"
+
+/* forward declarations */
+int main( int argc, char* argv[] );
+extern char** environ;
+extern void _bolthur_rpc_setup( void );
+// extern int _init_signal( void );
+
+/**
+ * @brief Function called before c main
+ */
+noreturn static int _main( int argc, char* argv[] ) {
+  // set environment global
+  environ = argv + argc + 1;
+  // execute main wrapped with exit
+  exit( main( argc, argv ) );
+}
+
+#if __thumb__ && !defined(PREFER_THUMB)
+asm("\n"
+  ".code 32\n"
+  ".global _start\n"
+  ".type _start, %function\n"
+  "_start:\n"
+  "\tldr r0, .LC0\n"
+  "\tbx r0\n"
+  ".LC0:\n"
+  "\t.word _start_thumb\n"
+  ".size _start, .-_start\n");
+
+__attribute__((naked, used))
+static void _start_thumb(void)
+#else
+__attribute__((naked))
+void _start(void)
+#endif
+{
+  // stack register
+  register int *sp asm( "sp" );
+  // init handling
+  #if defined( __USES_INITFINI__ )
+    // call init function depending on features
+    // fini functions are registered automatically
+    #if defined( HAVE_INITFINI_ARRAY )
+      // register fini if not registered automatically
+      #if ! defined( _WANT_REGISTER_FINI )
+        extern void __libc_fini_array( void );
+        if ( 0 != atexit( __libc_fini_array ) ) {
+          exit( -1 );
+        }
+      #endif
+      // init array
+      extern void __libc_init_array( void );
+      __libc_init_array();
+    #elif defined( HAVE_INIT_FINI )
+      // register fini if not registered automatically
+      #if ! defined( _WANT_REGISTER_FINI )
+        extern void _fini( void );
+        if ( 0 != atexit( _fini ) ) {
+          exit( -1 );
+        }
+      #endif
+      // call to init
+      extern void _init( void );
+      _init();
+    #endif
+  #endif
+  // shitty function call
+  _bolthur_rpc_setup();
+  // init signals
+  /*int signal_result = _init_signal();
+  if ( 0 != signal_result ) {
+    exit( signal_result );
+  }*/
+  // call early main
+  _main( *sp, ( char** )( sp + 1 ) );
+}
