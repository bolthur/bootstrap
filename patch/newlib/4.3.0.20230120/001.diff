diff --git newlib/libc/sys/bolthur/mman/mman-map.c newlib/libc/sys/bolthur/mman/mman-map.c
new file mode 100644
index 000000000..342d6192a
--- /dev/null
+++ newlib/libc/sys/bolthur/mman/mman-map.c
@@ -0,0 +1,179 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian FreitagFreitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/cdefs.h>
+#include <sys/bolthur.h>
+
+/**
+ * @fn void mmap*(void*, size_t, int, int, int, off_t)
+ * @brief map pages of memory
+ *
+ * @param addr address to start mapping at
+ * @param len length to map
+ * @param prot mapping properties
+ * @param flags mapping flags
+ * @param filedes file descriptor
+ * @param off offset for file descriptor
+ * @return void* mapped address or -1 on error
+ *
+ * @todo Add handling of MAP_SHARED
+ * @todo Implement address parameter correctly if not map fixed has been passed
+ */
+__weak_symbol void* mmap(
+  void* addr,
+  size_t len,
+  int prot,
+  int flags,
+  int filedes,
+  off_t off
+) {
+  if (
+    // handle invalid length
+    0 == len
+    // handle missing private or shared
+    || (
+      ! ( flags & MAP_SHARED )
+      && ! ( flags & MAP_PRIVATE )
+      && ! ( flags & MAP_ANONYMOUS )
+    )
+  ) {
+    errno = EINVAL;
+    return MAP_FAILED;
+  }
+  // system call protection parameter
+  int sys_prot = MEMORY_ACQUIRE_PROTECTION_NONE;
+  if ( prot & PROT_READ ) {
+    sys_prot |= MEMORY_ACQUIRE_PROTECTION_READ;
+  }
+  if ( prot & PROT_WRITE ) {
+    sys_prot |= MEMORY_ACQUIRE_PROTECTION_WRITE;
+  }
+  if ( prot & PROT_EXEC ) {
+    sys_prot |= MEMORY_ACQUIRE_PROTECTION_EXECUTABLE;
+  }
+  // shared mapping and fixed mapping are not yet supported
+  if ( flags & MAP_SHARED ) {
+    errno = EINVAL;
+    return MAP_FAILED;
+  }
+  // handle fixed with invalid address
+  if ( ( flags & MAP_FIXED ) && ! addr ) {
+    errno = EINVAL;
+    return MAP_FAILED;
+  }
+  // address parameter is only used for fixed and phys mapping
+  if ( ! ( flags & MAP_FIXED ) && ! ( flags & MAP_PHYSICAL ) ) {
+    addr = NULL;
+  }
+  // handle additional mapping flags
+  int sys_map = MEMORY_ACQUIRE_FLAG_NONE;
+  // handle map physical
+  if ( flags & MAP_PHYSICAL ) {
+    sys_map |= MEMORY_ACQUIRE_FLAG_PHYS;
+  }
+  // handle map device area
+  if ( flags & MAP_DEVICE ) {
+    sys_map |= MEMORY_ACQUIRE_FLAG_DEVICE;
+  }
+  // handle bus area
+  if ( flags & MAP_BUS ) {
+    sys_map |= MEMORY_ACQUIRE_FLAG_BUS;
+  }
+  // allocate memory
+  void* ret_addr = _syscall_memory_acquire( addr, len, sys_prot, sys_map );
+  // handle system call error
+  if ( errno ) {
+    return MAP_FAILED;
+  }
+  // clear acquired memory
+  if ( ! ( flags & MAP_PHYSICAL ) ) {
+    memset( ret_addr, 0, len );
+  }
+  // handle file descriptor
+  if ( -1 != filedes ) {
+    // set file pointer
+    off_t seek_result = lseek( filedes, off, SEEK_SET );
+    // handle error
+    if ( -1 == seek_result ) {
+      munmap( ret_addr, len );
+      errno = EIO;
+      return MAP_FAILED;
+    }
+    // read file into memory
+    ssize_t read_result = read(
+      filedes,
+      ( char* )ret_addr,
+      len
+    );
+    // handle error
+    if ( read_result != ( ssize_t )len ) {
+      // set errno if unmap fails
+      if ( 0 == munmap( ret_addr, len ) ) {
+        errno = EIO;
+      }
+      // return map failed
+      return MAP_FAILED;
+    }
+  }
+  // return allocated memory
+  return ret_addr;
+}
+
+/**
+ * @brief unmap pages of memory
+ *
+ * @param addr address to unmap
+ * @param len length
+ * @return int result
+ */
+__weak_symbol int munmap( void* addr, size_t len ) {
+  // handle invalid length
+  if ( 0 == len ) {
+    errno = EINVAL;
+    return -1;
+  }
+  // request release and return response
+  _syscall_memory_release( addr, len );
+  // return -1 on error
+  if ( errno ) {
+    return -1;
+  }
+  // return 0 as success
+  return 0;
+}
+
+/**
+ * @brief set protection of memory mapping
+ *
+ * @param addr
+ * @param len
+ * @param prot
+ * @return int
+ */
+__weak_symbol int mprotect( void* addr, size_t len, int prot ) {
+  errno = ENOSYS;
+  return -1;
+}
+
+/**
+ * @brief synchronize memory with physical storage
+ *
+ * @param addr
+ * @param len
+ * @param flags
+ * @return int
+ */
+__weak_symbol int msync( void* addr, size_t len, int flags ) {
+  errno = ENOSYS;
+  return -1;
+}
