+SYSTEM_CALL( syscall_memory_shared_detach )
+SYSTEM_CALL( syscall_memory_shared_size )
+SYSTEM_CALL( syscall_memory_translate_physical )
+SYSTEM_CALL( syscall_memory_translate_bus )
+
+SYSTEM_CALL( syscall_rpc_set_handler )
+SYSTEM_CALL7( syscall_rpc_raise )
+SYSTEM_CALL( syscall_rpc_ret )
+SYSTEM_CALL( syscall_rpc_get_data )
+SYSTEM_CALL( syscall_rpc_get_data_size )
+SYSTEM_CALL( syscall_rpc_wait_for_call )
+SYSTEM_CALL( syscall_rpc_set_ready )
+SYSTEM_CALL( syscall_rpc_end )
+SYSTEM_CALL( syscall_rpc_wait_for_ready )
+SYSTEM_CALL( syscall_rpc_clear_data )
