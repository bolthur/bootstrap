diff --git newlib/libc/sys/bolthur/rpc/rpc-async.c newlib/libc/sys/bolthur/rpc/rpc-async.c
new file mode 100644
index 000000000..7330dcf05
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-async.c
@@ -0,0 +1,252 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+
+/**
+ * @fn int comp(const void*, const void*)
+ * @brief rpc compare helper for sorting
+ *
+ * @param a
+ * @param b
+ * @return
+ *
+ * @todo add logic
+ * @todo add reentrance support
+ */
+static int comp( const void* a, const void* b ) {
+  return ( ( bolthur_async_data_t* )a )->rpc_id
+    - ( ( bolthur_async_data_t* )b )->rpc_id;
+}
+
+/**
+ * @fn void bolthur_rpc_destroy_async(bolthur_async_data_t*)
+ * @brief Destroy async data
+ *
+ * @param async async data to destroy
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void bolthur_rpc_destroy_async( bolthur_async_data_t* async ) {
+  // return if address is NULL
+  if ( ! async ) {
+    return;
+  }
+  // free data if set
+  if ( async->original_data ) {
+    free( async->original_data );
+  }
+  free( async );
+}
+
+/**
+ * @fn bool bolthur_rpc_push_async(size_t, size_t, void*, size_t, pid_t, rpc_handler_t, void*)
+ * @brief Push async request to list
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @param data original request
+ * @param length original request length
+ * @param origin original origin
+ * @param original_rpc_id original rpc id
+ * @param callback callback to call on answer
+ * @param context additional data to be stored
+ * @return true on success or false on error
+ *
+ * @exception ENOMEM Not enough element to return found item or rebuild item list
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol bool bolthur_rpc_push_async(
+  size_t num,
+  size_t rpc_id,
+  void* data,
+  size_t length,
+  pid_t origin,
+  size_t original_rpc_id,
+  rpc_handler_t callback,
+  void* context
+) {
+  // duplicaate data
+  void* tmp = malloc( length );
+  if ( ! tmp ) {
+    errno = ENOMEM;
+    return false;
+  }
+  memcpy( tmp, data, length );
+  // extend array
+  size_t new_size = _bolthur_async_data_size + 1;
+  size_t last_index = _bolthur_async_data_size;
+  // extend array
+  bolthur_async_data_t* new_list = realloc(
+    _bolthur_async_data,
+    sizeof( bolthur_async_data_t ) * new_size
+  );
+  // handle error
+  if ( ! new_list ) {
+    free( tmp );
+    errno = ENOMEM;
+    return false;
+  }
+  // overwrite handler custom pointer and size
+  _bolthur_async_data = new_list;
+  _bolthur_async_data_size = new_size;
+  // push container
+  _bolthur_async_data[ last_index ].type = num;
+  _bolthur_async_data[ last_index ].rpc_id = rpc_id;
+  _bolthur_async_data[ last_index ].original_data = tmp;
+  _bolthur_async_data[ last_index ].length = length;
+  _bolthur_async_data[ last_index ].original_origin = origin;
+  _bolthur_async_data[ last_index ].original_rpc_id = original_rpc_id;
+  _bolthur_async_data[ last_index ].callback = callback;
+  _bolthur_async_data[ last_index ].context = context;
+  // sort array after push
+  qsort(
+    _bolthur_async_data,
+    _bolthur_async_data_size,
+    sizeof( bolthur_async_data_t ),
+    comp
+  );
+  return true;
+}
+
+/**
+ * @fn rpc_handler_t bolthur_rpc_async_callback(size_t)
+ * @brief Helper to get rpc async callback by rpc id
+ *
+ * @param rpc_id
+ * @return
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol rpc_handler_t bolthur_rpc_async_callback( size_t rpc_id ) {
+  // find by rpc id
+  for( size_t index = 0; index < _bolthur_async_data_size; index++ ) {
+    if ( rpc_id == _bolthur_async_data[ index ].rpc_id ) {
+      return _bolthur_async_data[ index ].callback;
+    }
+  }
+  // not found
+  return NULL;
+}
+
+/**
+ * @fn bool bolthur_rpc_has_async(size_t, size_t, bool)
+ * @brief helper to check for async data by type and rpc id
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @return bool
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol bool bolthur_rpc_has_async( size_t num, size_t rpc_id ) {
+  // find by rpc id
+  for( size_t index = 0; index < _bolthur_async_data_size; index++ ) {
+    if (
+      rpc_id == _bolthur_async_data[ index ].rpc_id
+      && num == _bolthur_async_data[ index ].type
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * @fn bolthur_async_data_t* bolthur_rpc_pop_async(size_t, size_t)
+ * @brief pop async data by type and rpc id
+ *
+ * @param num request type
+ * @param rpc_id async rpc data id
+ * @return async request info or NULL if not existing
+ *
+ * @exception ENOMEM Not enough element to return found item or rebuild item list
+ *
+ * @todo add reentrance support
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol bolthur_async_data_t* bolthur_rpc_pop_async(
+  size_t num,
+  size_t rpc_id
+) {
+  // find by rpc id
+  for( size_t index = 0; index < _bolthur_async_data_size; index++ ) {
+    if (
+      rpc_id == _bolthur_async_data[ index ].rpc_id
+      && num == _bolthur_async_data[ index ].type
+    ) {
+      // allocate return container
+      bolthur_async_data_t* ret = malloc( sizeof( bolthur_async_data_t ) );
+      if ( ! ret ) {
+        errno = ENOMEM;
+        return NULL;
+      }
+      memset( ret, 0, sizeof( bolthur_async_data_t ) );
+      size_t data_length = _bolthur_async_data[ index ].length;
+      ret->original_data = malloc( data_length );
+      if ( ! ret->original_data ) {
+        bolthur_rpc_destroy_async( ret );
+        errno = ENOMEM;
+        return NULL;
+      }
+      // populate return
+      ret->type = _bolthur_async_data[ index ].type;
+      ret->rpc_id = _bolthur_async_data[ index ].rpc_id;
+      ret->length = _bolthur_async_data[ index ].length;
+      ret->original_origin = _bolthur_async_data[ index ].original_origin;
+      ret->original_rpc_id = _bolthur_async_data[ index ].original_rpc_id;
+      ret->callback = _bolthur_async_data[ index ].callback;
+      ret->context = _bolthur_async_data[ index ].context;
+      memcpy( ret->original_data, _bolthur_async_data[ index ].original_data, data_length );
+      // allocate new list
+      size_t new_async_size = _bolthur_async_data_size - 1;
+      size_t alloc_size = sizeof( bolthur_async_data_t ) * new_async_size;
+      bolthur_async_data_t* new_async_data = malloc( alloc_size );
+      // handle error
+      if ( ! new_async_data ) {
+        bolthur_rpc_destroy_async( ret );
+        errno = ENOMEM;
+        return NULL;
+      }
+      // clear out
+      memset( new_async_data, 0, alloc_size );
+      // copy over index by index
+      size_t push_index = 0;
+      for ( size_t inner = 0; inner < _bolthur_async_data_size; inner++ ) {
+        // skip current element to remove
+        if ( inner == index ) {
+          free( _bolthur_async_data[ inner ].original_data );
+          continue;
+        }
+        // copy content
+        memcpy(
+          &new_async_data[ push_index ],
+          &_bolthur_async_data[ inner ],
+          sizeof( bolthur_async_data_t )
+        );
+        // increment index
+        push_index++;
+      }
+      // destroy old async list
+      free( _bolthur_async_data );
+      // set again and set also new async size
+      _bolthur_async_data = new_async_data;
+      _bolthur_async_data_size = new_async_size;
+      // return element
+      return ret;
+    }
+  }
+  // return NULL as not found
+  return NULL;
+}
diff --git newlib/libc/sys/bolthur/rpc/rpc-bind.c newlib/libc/sys/bolthur/rpc/rpc-bind.c
new file mode 100644
index 000000000..f6b0496e7
--- /dev/null
+++ newlib/libc/sys/bolthur/rpc/rpc-bind.c
@@ -0,0 +1,120 @@
+
+/**
+ * Written by Christian Freitag <cfreitag.cf@googlemail.com>
+ * Copyright 2020 - 2023 (c) Christian Freitag
+ *
+ * Permission to use, copy, modify, and distribute this software
+ * is freely granted, provided that this notice is preserved.
+ */
+
+#include "rpc-rpc.h"
+
+/**
+ * @fn int comp(const void*, const void*)
+ * @brief rpc compare helper for sorting
+ *
+ * @param a
+ * @param b
+ * @return
+ *
+ * @todo add logic
+ * @todo add reentrance support
+ */
+static int comp( const void* a, const void* b ) {
+  return ( ( struct handler_container* )a )->num
+    - ( ( struct handler_container* )b )->num;
+}
+
+/**
+ * @fn void bolthur_rpc_bind(size_t, rpc_handler_t, bool)
+ * @brief rpc bind handler
+ *
+ * @param num
+ * @param handler
+ * @param overwrite
+ *
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void bolthur_rpc_bind( size_t num, rpc_handler_t handler, bool overwrite ) {
+  _bolthur_rpc_bind_r( _REENT, num, handler, overwrite );
+}
+
+/**
+ * @fn void _bolthur_rpc_bind_r(size_t, rpc_handler_t)
+ * @brief reentrant rpc bind handler
+ *
+ * @param rptr
+ * @param num
+ * @param handler
+ * @param overwrite
+ *
+ * @todo remove __weak_symbol once finished
+ */
+__weak_symbol void _bolthur_rpc_bind_r(
+  struct _reent* r,
+  size_t num,
+  rpc_handler_t handler,
+  bool overwrite
+) {
+  // handle bind interrupt
+  if ( num <= RPC_INTERRUPT_END ) {
+    // check if already set
+    rpc_handler_t current = _bolthur_handler_interrupt[ num ];
+    if ( current && ! overwrite ) {
+      r->_errno = EPROTO;
+      return;
+    }
+    // set interrupt
+    _bolthur_handler_interrupt[ num ] = handler;
+    // skip rest
+    return;
+  }
+
+  // signals not handled here
+  if ( num >= RPC_SIGNAL_START && num <= RPC_SIGNAL_END ) {
+    r->_errno = ENOSYS;
+    return;
+  }
+
+  // try to find existing handler by number
+  for ( size_t idx = 0; idx < _bolthur_handler_custom_size; idx++ ) {
+    // return handler if num is equal
+    if ( num == _bolthur_handler_custom[ idx ].num ) {
+      if ( ! overwrite ) {
+        r->_errno = EPROTO;
+        return;
+      }
+      // set handler
+      _bolthur_handler_custom[ idx ].handler = handler;
+      // skip rest
+      return;
+    }
+  }
+
+  // get new size and last index
+  size_t new_size = _bolthur_handler_custom_size + 1;
+  size_t last_index = _bolthur_handler_custom_size;
+  // extend array
+  struct handler_container* new_list = realloc(
+    _bolthur_handler_custom,
+    sizeof( struct handler_container ) * new_size
+  );
+  // handle error
+  if ( ! new_list ) {
+    r->_errno = ENOMEM;
+    return;
+  }
+  // overwrite handler custom pointer and size
+  _bolthur_handler_custom = new_list;
+  _bolthur_handler_custom_size = new_size;
+  // push handler
+  _bolthur_handler_custom[ last_index ].handler = handler;
+  _bolthur_handler_custom[ last_index ].num = num;
+  // sort array after push
+  qsort(
+    _bolthur_handler_custom,
+    _bolthur_handler_custom_size,
+    sizeof( struct handler_container ),
+    comp
+  );
+}
